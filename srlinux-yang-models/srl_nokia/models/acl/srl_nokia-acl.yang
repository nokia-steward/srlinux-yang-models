module srl_nokia-acl {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:acl:acl";
  prefix srl-acl;

  import srl_nokia-packet-match-types {
    prefix srl-pkt-matc-type;
  }
  import srl_nokia-interfaces {
    prefix srl-ifs;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-qos {
    prefix srl-qos;
  }
  import srl_nokia-network-instance {
    prefix srl-netinst;
  }
  import srl_nokia-system {
    prefix srl-sys;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines configuration and operational state data for access control lists (ACLs) and related objects.

     Copyright 2019-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2026-03-31 {
    description
      "SR Linux 26.3.1";
  }
  revision 2025-10-31 {
    description
      "SR Linux 25.10.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }
  revision 2024-10-31 {
    description
      "SR Linux 24.10.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }
  revision 2023-10-31 {
    description
      "SR Linux 23.10.1";
  }
  revision 2023-07-31 {
    description
      "SR Linux 23.7.1";
  }
  revision 2023-03-31 {
    description
      "SR Linux 23.3.1";
  }
  revision 2022-11-30 {
    description
      "SR Linux 22.11.1";
  }
  revision 2022-06-30 {
    description
      "SR Linux 22.6.1";
  }
  revision 2022-03-31 {
    description
      "SR Linux 22.3.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }
  revision 2020-06-30 {
    description
      "SR Linux 20.6.1";
  }
  revision 2019-11-30 {
    description
      "SR Linux 19.11.1";
  }

  grouping interface-filter-entry-tcam {
    container tcam-entries {
      description
        "Enter the tcam-entries context

         Information about the TCAM entries used to implement the ACL entry";
      config false;
      list forwarding-complex {
        description
          "List of forwarding complexes in the system";
        key "complex-identifier";
        leaf complex-identifier {
          description
            "A forwarding complex in the format (slot-number,complex-number).";
          type string;
        }
        leaf single-instance {
          type uint16;
          description
            "The number of TCAM entries required to implement this entry if it is applied to only one subinterface and one traffic direction specific to this slot.

             This is non-zero even if the filter is not applied to any subinterfaces of this complex. It captures the effect of TCAM entry expansion to deal with L4 port or VLAN ranges, for example.";
        }
        leaf input-total {
          if-feature "not srl-feat:fpcx";
          type uint16;
          description
            "The number of TCAM entries required to implement this entry on all subinterfaces of this complex where the filter is applied to ingress traffic.

             For example, if a single-instance of the entry takes 2 TCAM entries and the filter is an output-only subinterface-specific filter and the filter is applied to 5 subinterfaces on output and to 5 subinterfaces on input then input-total=2. If the entry is not applied to ingress traffic on any subinterfaces of this complex then input-total=0.";
        }
        leaf output-total {
          if-feature "not srl-feat:fpcx";
          type uint16;
          description
            "The number of TCAM entries required to implement this entry on all subinterfaces of this complex where the filter is applied to egress traffic.

             For example, if a single-instance of the entry takes 2 TCAM entries and the filter is an output-only subinterface-specific filter and the filter is applied to 5 subinterfaces on output and to 5 subinterfaces on input then output-total=10. If the entry is not applied to egress traffic on any subinterfaces of this complex then output-total=0.";
        }
      }
    }
  }

  grouping policer-stats-two-rates {
    leaf conforming-in-packets {
      if-feature "srl-feat:acl-pps-policer-committed-rate";
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered conforming below commited rate by the policer";
    }
    leaf conforming-out-packets {
      if-feature "srl-feat:acl-pps-policer-committed-rate";
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered conforming below peak rate and above commited rate by the policer";
    }
    leaf conforming-in-octets {
      if-feature "srl-feat:acl-pps-policer-committed-rate";
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered conforming below commited rate by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
    leaf conforming-out-octets {
      if-feature "srl-feat:acl-pps-policer-committed-rate";
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered conforming below peak rate and above commited by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
  }

  grouping policer-stats {
    leaf conforming-packets {
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered conforming by the policer";
    }
    leaf conforming-octets {
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered conforming by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
    leaf exceeding-packets {
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered exceeding by the policer";
    }
    leaf exceeding-octets {
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered exceeding by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
  }

  grouping policer-stats-input-output {
    leaf in-conforming-packets {
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered conforming by the policer";
    }
    leaf in-conforming-octets {
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered conforming by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
    leaf in-exceeding-packets {
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered exceeding by the policer";
    }
    leaf in-exceeding-octets {
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered exceeding by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
    leaf out-conforming-packets {
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered conforming by the policer";
    }
    leaf out-conforming-octets {
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered conforming by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
    leaf out-exceeding-packets {
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered exceeding by the policer";
    }
    leaf out-exceeding-octets {
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered exceeding by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
  }

  grouping acl-policers-top {
    container policers {
      description
        "Enter the policers context

         Container for policer definitions used by ACL entries";
      list system-cpu-policer {
        description
          "List of system CPU policer templates. For each policer in this list one or more policer instances are implemented in the XDP-CPM software and these policer instances process the aggregate of terminating traffic received from all linecards.";
        key "name";
        leaf name {
          description
            "User-defined name of the policer";
          type srl-comm:name;
        }
        leaf entry-specific {
          description
            "If set to false, only one policer instance is created from this template and it is shared by all entries of all cpm-filter ACLs that refer to this policer.

             If set to true, multiple policer instances are created from this template, one for each cpm-filter entry that refers to the policer template.";
          type boolean;
          default "false";
        }
        leaf peak-rate-pps {
          type uint32 {
            range "1.. 4000000";
          }
          description
            "The maximum number of packets per second (bucket empty/fill rate)";
        }
        leaf maximum-burst-packet {
          type uint32 {
            range "16.. 4000000";
          }
          default "16";
          description
            "The maximum depth of the policer bucket in number of packets";
        }
        container statistics {
          srl-exts:delivery-node-override "true";
          config false;
          description
            "Enter the statistics context

             Container for system CPU policer statistics

             None of these statistics are populated if the policer is configured as entry-specific=true.";
          uses policer-stats;
          leaf last-clear {
            type srl-comm:date-and-time-delta;
            description
              "Time of the last clear command that applied to these statistics";
          }
          action clear {
            srl-exts:telemetry-capability "unsupported";
            if-feature "srl-feat:tools-as-modeled-actions-same-io";
            description
              "Execute the clear action

               Reset all statistics associated with this particular policer to zero";
          }
        }
      }
      list policer {
        if-feature "srl-feat:acl-policer";
        description
          "List of policer templates used in subintreface and CPM Filter ACL.";
        key "name";
        leaf name {
          description
            "User-defined name of the policer";
          type srl-comm:name;
        }
        leaf entry-specific {
          if-feature "not srl-feat:fpcx";
          type boolean;
          default "false";
          description
            "Controls the instantiation of the policer between filter entries

             false: one policer instance is created from this template and it is shared by all entries of in the same ACL filter that refer to this policer

             true: multiple policer instances are created from this template, one for each ACL filter entry that refers to this policer";
        }
        leaf scope {
          if-feature "srl-feat:subif-acl-policer";
          type enumeration {
            enum global {
              value 1;
            }
            enum subinterface {
              value 2;
            }
          }
          default "global";
          description
            "Controls the instantiation of the policer between subinterfaces

             global: policer is instantiated per direction and shared between ACL, requires filter subinterface-specific disabled

             subinterface: policer is instantiated per subinterface and per direction, requires filter subinterface-specific input-and-ouput";
        }
        choice rate-parameters {
          description
            "Select between bit rate and packet rate policers.";
          case rate-bps {
            description
              "Rate-based rate limit configuration.";
            leaf peak-rate-kbps {
              type uint32 {
                range "1..800000000";
              }
              units "kbps";
              description
                "The peak information rate (PIR) in kbps (bucket empty/fill rate).";
            }
            leaf maximum-burst-size {
              type uint32 {
                range "1..125000000";
              }
              units "bytes";
              description
                "The MBS bucket depth in bytes";
            }
          }
          case rate-pps {
            if-feature "srl-feat:acl-pps-policer";
            description
              "Packet-based rate limit configuration.";
            leaf peak-rate-pps {
              type uint32 {
                range "64..4000000";
              }
              default "64";
              must '. >= ../committed-rate-pps' {
                error-message "Peak rate must be greater than or equal to committed rate.";
              }
              description
                "The maximum number of packets per second (bucket empty/fill rate)";
            }
            leaf maximum-burst-packet {
              type uint32 {
                range "32..126976";
              }
              default "32";
              description
                "The maximum depth of the policer bucket in number of packets";
            }
            leaf committed-rate-pps {
              if-feature "srl-feat:acl-pps-policer-committed-rate";
              type uint32 {
                range "1.. 4000000";
              }
              default "1";
              description
                "The committed number of packets per second";
            }
            leaf committed-burst-packet {
              if-feature "srl-feat:acl-pps-policer-committed-rate";
              type uint32 {
                range "32.. 4000000";
              }
              default "32";
              description
                "The committed depth of the policer bucket in number of packets";
            }
          }
        }
        container statistics {
          config false;
          description
            "Enter the statistics context

             Container for linecard policer statistics.";
          container aggregate {
            srl-exts:delivery-node-override "true";
            leaf last-clear {
              type srl-comm:date-and-time-delta;
              description
                "Time of the last clear command that applied to these statistics";
            }
            description
              "Enter the aggregate context

               None of these statistics are populated if the policer is configured as entry-specific=true.

                   If entry-specific=false and subinterface-specific=true, this is sum of all the entries and all the policer templates instantiated for all subintrefaces.

                   If entry-specific=false and subinterface-specific=false, this is sum of all the entries using this policer template.";
            uses policer-stats;
            uses policer-stats-two-rates;
          }
          action clear {
            srl-exts:telemetry-capability "unsupported";
            if-feature "srl-feat:tools-as-modeled-actions-same-io";
            description
              "Execute the clear action

               Reset all statistics associated with this particular policer to zero";
          }
        }
      }
    }
  }

  grouping datapath-programming {
    container datapath-programming {
      config false;
      description
        "Enter the datapath-programming context

         Container to represent the progress of ACL datapath programming";
      list forwarding-complex {
        description
          "List of forwarding complexes that are currently installed and online";
        key "slot-id complex-id";
        leaf slot-id {
          description
            "The slot id";
          type uint8;
        }
        leaf complex-id {
          description
            "The complex id";
          type uint8 {
            range "0..1";
          }
        }
        leaf programming-complete {
          description
            "Reads false when there are still pending entries to program from prior configuration transactions

             Reads true when all datapath programming related to all prior ACL configuration changes is complete";
          type boolean;
        }
        leaf last-completed-timestamp {
          type srl-comm:date-and-time-delta;
          description
            "The date and time when the forwarding complex last completed all datapath programming related to prior ACL configuration changes.";
        }
      }
    }
  }

  grouping prefix-list-apply-path {
    description
      "Configuration of Prefix List Apply Path";
    list apply-path {
      description
        "Specifies a filter match list IP prefix lists apply-path";
      key "index";
      leaf index {
        type uint8 {
          range "1..255";
        }
        description
          "This object specifies an index of the selection criterion";
      }
      container network-instance {
        choice match-type {
          mandatory true;
          case name-reference {
            leaf match {
              type leafref {
                path "/srl-netinst:network-instance/srl-netinst:name";
              }
            }
          }
          case regex {
            leaf match-pattern {
              type srl-comm:regex-string;
            }
          }
        }
        description
          "Enter the network-instance context

           Reference to a specific network-instance, either name or regular-expression to match multiple network-instances";
        container source {
          choice source-selection {
            case interface {
              if-feature "srl-feat:acl-ip-prefix-list-apply-path-interfaces";
              leaf interface {
                type srl-comm:regex-string;
                description
                  "This object specifies a match condition on the IP or IPv6 address of configured interfaces";
              }
            }
            case protocol {
              if-feature "srl-feat:acl-ip-prefix-list-apply-path-bgp-peers";
              container protocol {
                container bgp {
                  leaf group {
                    type srl-comm:regex-string;
                    description
                      "This specifies a match condition on the group name of configured bgp peers";
                  }
                  leaf neighbor {
                    type srl-comm:regex-string;
                    description
                      "This specifies a match condition on the IP or IPv6 addresses of configured bgp peers";
                  }
                  description
                    "Enter the bgp context";
                }
                description
                  "Enter the protocol context";
              }
            }
          }
          description
            "Enter the source context";
        }
      }
    }
  }

  grouping ipv4-prefix-list {
    description
      "Configuration of IPv4 Prefix List";
    list ipv4-prefix-list {
      key "name";
      max-elements 2048;
      description
        "A user defined IPv4 prefix list description";
      leaf name {
        type srl-comm:name;
        description
          "Reference to the name of the IPv4 prefix list";
      }
      leaf description {
        type srl-comm:description-4k-chars;
        description
          "Description string for the prefix list";
      }
      list prefix {
        key "ipv4-prefix";
        max-elements 8192;
        description
          "List of IPv4 prefixes";
        leaf ipv4-prefix {
          type srl-comm:ipv4-prefix;
          description
            "A user defined IPv4 prefix";
        }
      }
      uses prefix-list-apply-path {
        if-feature "srl-feat:acl-ip-prefix-list-apply-path-bgp-peers or srl-feat:acl-ip-prefix-list-apply-path-interfaces";
      }
    }
  }

  grouping ipv6-prefix-list {
    description
      "Configuration of IPv6 Prefix List";
    list ipv6-prefix-list {
      key "name";
      max-elements 2048;
      description
        "A user defined IPv6 prefix list description";
      leaf name {
        type srl-comm:name;
        description
          "Reference to the name of the IPv6 prefix list";
      }
      leaf description {
        type srl-comm:description-4k-chars;
        description
          "Description string for the prefix list";
      }
      list prefix {
        key "ipv6-prefix";
        max-elements 8192;
        description
          "List of IPv6 prefixes";
        leaf ipv6-prefix {
          type srl-comm:ipv6-prefix;
          description
            "A user defined IPv6 prefix";
        }
      }
      uses prefix-list-apply-path {
        if-feature "srl-feat:acl-ip-prefix-list-apply-path-bgp-peers or srl-feat:acl-ip-prefix-list-apply-path-interfaces";
      }
    }
  }

  grouping port-list {
    description
      "Configuration of Port List";
    list port-list {
      key "name";
      max-elements 2048;
      description
        "A user defined L4 port list";
      leaf name {
        type srl-comm:name;
        description
          "Reference to the name of the port list";
      }
      leaf description {
        type srl-comm:description;
        description
          "Description string for the port list";
      }
      list port {
        key "id";
        description
          "List of ports or port-ranges";
        max-elements 64;
        leaf id {
          type uint8 {
            range "1..64";
          }
          description
            "Identifier of the port-list entry ";
        }
        choice port {
          mandatory true;
          case value {
            leaf value {
              type srl-pkt-matc-type:l4-port-type;
              description
                "A destination port number";
            }
          }
          case range {
            container range {
              description
                "Enter the range context

                 Container used to specify a contiguous range of TCP/UDP port numbers";
              leaf start {
                type srl-pkt-matc-type:l4-port-type;
                description
                  "The starting port number to include in the range";
                must "string(../end) != ''" {
                  error-message "The port-list end value must also be specified to use range";
                }
              }
              leaf end {
                type srl-pkt-matc-type:l4-port-type;
                description
                  "The ending port number to include in the range";
                must "string(../start) != ''" {
                  error-message "The port-list start value must also be specified to use range";
                }
              }
            }
          }
        }
      }
    }
  }

  grouping ipv4-packet-length-list {
    description
      "Configuration of Ipv4 Packet-length List";
    list ipv4-packet-length-list {
      key "name";
      max-elements 2048;
      description
        "A user defined Ipv4 packet length list";
      leaf name {
        type srl-comm:name;
        description
          "Reference to the name of the packet-length list";
      }
      leaf description {
        type srl-comm:description;
        description
          "Description string for the list";
      }
      list packet-length {
        key "id";
        description
          "List of packet-length values or ranges";
        max-elements 64;
        leaf id {
          type uint8 {
            range "1..64";
          }
          description
            "Identifier of the packet-length-list entry ";
        }
        choice packet-length {
          mandatory true;
          case value {
            leaf value {
              type uint32 {
                range "0..65535";
              }
              description
                "Packet Length value";
            }
          }
          case range {
            container range {
              leaf start {
                type uint32 {
                  range "0..65535";
                }
                description
                  "The starting packet-length value to include in the range";
                must "string(../end) != ''" {
                  error-message "The packet-length end value must also be specified to use range";
                }
                must '../end >= .' {
                  error-message "The packet-length end value must be greater than start";
                }
              }
              leaf end {
                type uint32 {
                  range "0..65535";
                }
                description
                  "The ending packet-length value to include in the range";
                must "string(../start) != ''" {
                  error-message "The packet-length start value must also be specified to use range";
                }
                must '../start <= .' {
                  error-message "The packet-length end value must be greater than start";
                }
              }
              description
                "Enter the range context";
            }
          }
        }
      }
    }
  }

  grouping ipv6-packet-length-list {
    description
      "Configuration of Ipv6 Packet-length List";
    list ipv6-packet-length-list {
      key "name";
      max-elements 2048;
      description
        "A user defined Ipv6 packet length list";
      leaf name {
        type srl-comm:name;
        description
          "Reference to the name of the packet-length list";
      }
      leaf description {
        type srl-comm:description;
        description
          "Description string for the list";
      }
      list packet-length {
        key "id";
        description
          "List of packet-length values or ranges";
        max-elements 64;
        leaf id {
          type uint8 {
            range "1..64";
          }
          description
            "Identifier of the packet-length-list entry ";
        }
        choice packet-length {
          mandatory true;
          case value {
            leaf value {
              type uint32 {
                range "40..65575";
              }
              description
                "Packet Length value";
            }
          }
          case range {
            container range {
              leaf start {
                type uint32 {
                  range "40..65575";
                }
                description
                  "The starting packet-length value to include in the range";
                must "string(../end) != ''" {
                  error-message "The packet-length end value must also be specified to use range";
                }
                must '../end >= .' {
                  error-message "The packet-length end value must be greater than start";
                }
              }
              leaf end {
                type uint32 {
                  range "40..65575";
                }
                description
                  "The ending packet-length value to include in the range";
                must "string(../start) != ''" {
                  error-message "The packet-length start value must also be specified to use range";
                }
                must '../start <= .' {
                  error-message "The packet-length end value must be greater than start";
                }
              }
              description
                "Enter the range context";
            }
          }
        }
      }
    }
  }

  grouping match-list-top {
    description
      "Top level grouping for match-list";
    container match-list {
      description
        "Enter the match-list context

         Top level container for match list model config and operational state data";
      uses ipv4-prefix-list {
        if-feature "srl-feat:acl-ip-prefix-list";
      }
      uses ipv6-prefix-list {
        if-feature "srl-feat:acl-ip-prefix-list";
      }
      uses ipv4-packet-length-list {
        if-feature "srl-feat:acl-ip-packet-length";
      }
      uses ipv6-packet-length-list {
        if-feature "srl-feat:acl-ip-packet-length";
      }
      uses port-list {
        if-feature "srl-feat:acl-l4-port-list";
      }
    }
  }

  typedef acl-filter-entry-source-type {
    type enumeration {
      enum static-config {
        description
          "Statically configured";
      }
      enum bgp-flowspec {
        description
          "BGP Flowspec as embed source";
      }
      enum subscriber-management {
        if-feature "srl-feat:submgmt-fpcx";
        description
          "Subscriber management as embed source";
      }
    }
    description
      "Source types for ACL entries";
  }

  grouping acl-filter-common-embed-state {
    leaf oper-state {
      config false;
      type srl-comm:oper-state;
      description
        "Operational state of this embed source on the filter

         up when every candidate entry is programmed and the filter is applied.
         degraded when programmed is greater than zero and the candidate set is
         not fully programmed (TCAM and/or range). down when programmed is zero,
         the filter is not applied, or the embed source is unavailable.
         oper-state-reasons is present when down or degraded.";
    }
    leaf-list oper-state-reasons {
      config false;
      type enumeration {
        enum filter-not-applied {
          description
            "The filter is not associated in config, or the datapath has no
             binding of this filter to an interface";
        }
        enum source-unavailable {
          description
            "The embed source is not available, for example its referenced
             network-instance is administratively or operationally down or
             does not exist";
        }
        enum tcam-resources-exhausted {
          description
            "Hardware TCAM could not program every candidate entry from this
             source";
        }
        enum range-exceeded {
          description
            "candidate-entries exceed this binding range

             Increase range to embed them.";
        }
      }
      description
        "Reasons this embed source is down or degraded

         Absent when oper-state is up. Multiple values may be present together.";
    }
    leaf candidate-entries {
      config false;
      type uint32;
      description
        "Number of dynamic entries this source presented to the filter for embedding, after any network-instance flowspec cap.

         May exceed range: entries beyond range cannot be embedded and are reported in oper-state-reasons as range-exceeded.";
    }
    leaf programmed {
      config false;
      type uint32;
      description
        "Number of dynamic entries from this source successfully embedded and programmed into hardware. This count never exceeds candidate-entries or range.";
    }
  }

  grouping acl-filter-embed-flowspec {
    container bgp-flowspec {
      leaf network-instance {
        type leafref {
          path "/srl-netinst:network-instance/srl-netinst:name";
        }
        mandatory true;
        must 'not(/srl-netinst:network-instance[srl-netinst:name=current()]/srl-netinst:type = "srl-netinst:mac-vrf")' {
          error-message "The network-instance cannot be of type 'mac-vrf'";
        }
        description
          "Network-instance from which Flowspec rules for this embed source are taken (mandatory)";
      }
      leaf group {
        type uint32 {
          range "0..65535";
        }
        default "0";
        description
          "Interface-set extended-community group-id filter

           When non-zero, only Flowspec routes carrying this interface-set group-id are embedded. Zero disables group filtering for this source.";
      }
      leaf collect-stats {
        if-feature "srl-feat:acl-filter-embed-collect-stats";
        type boolean;
        default "true";
        description
          "Collect statistics for FlowSpec rows programmed by this embedding

           When false, no hardware statistics resources are allocated for those rows.
           CAM programming is unchanged. If statistics resources are exhausted, CAM
           stays and the row does not collect statistics.";
      }
      description
        "Enter the bgp-flowspec context";
    }
  }

  grouping acl-filter-embed-top {
    description
      "Flowspec and future embed sources: offset, range, and operational embedded rows

       Static entry sequence-ids disjoint from each source span from offset through offset plus range minus one.";
    list embedding {
      if-feature "srl-feat:acl-filter-embed-entries-bgp-fs or srl-feat:submgmt-fpcx";
      description
        "Per-source embed configuration

         Multiple embedding instances are allowed. Non-overlapping offset and range vs static entries and other embed instances is enforced by the ACL manager.";
      must "not (../name = 'system' or ../name = 'capture')" {
        error-message "Embedding dynamic entries not allowed for acl-filter name system or capture";
      }
      key "index";
      leaf index {
        type uint8 {
          range "1..15";
        }
        description
          "Distinguishes this embed source among up to fifteen bindings on the filter";
      }
      leaf offset {
        type uint32 {
          range "0..65535";
        }
        mandatory true;
        description
          "Base sequence-id where embedded entries for this source start";
      }
      leaf range {
        type uint32 {
          range "1..65536";
        }
        mandatory true;
        description
          "Maximum embedded entries for this source

           Occupies sequence-ids offset through offset plus range minus one; must not overlap static entries or other embed sources.";
      }
      choice embed-source-type {
        description
          "Type of embed source for this binding";
        case bgp-flowspec {
          if-feature "srl-feat:acl-filter-embed-entries-bgp-fs";
          uses acl-filter-embed-flowspec;
        }
        case subscriber-management {
          if-feature "srl-feat:submgmt-fpcx";
          container subscriber-management {
            presence "Embed dynamic subscriber management entries into this filter";
            must "../../owner = 'subscriber-management'" {
              error-message "subscriber-management embedding requires owner subscriber-management";
            }
            description
              "Enter the subscriber-management context

               Marks this embedding as the insertion point for dynamic subscriber management filter entries. The parent ACL filter must have owner subscriber-management.";
          }
        }
      }
      uses acl-filter-common-embed-state;
    }
    container embedded-entries {
      if-feature "srl-feat:acl-filter-embed-entries-bgp-fs or srl-feat:submgmt-fpcx";
      config false;
      description
        "Enter the embedded-entries context

         Operational rows programmed from embed sources, separate from the static entry list";
      list entry {
        key "sequence-id";
        description
          "One dynamically programmed ACL row for this filter";
        leaf sequence-id {
          type uint32 {
            range "0..65535";
          }
          description
            "Sequence-id of this embedded entry within the filter";
        }
        leaf embedding-index {
          type leafref {
            path "../../../embedding/index";
          }
          description
            "Embedding binding that programmed this row

             References the embedding index whose offset and range cover this sequence-id, identifying which embed source produced this entry and, transitively, its network-instance and group.";
        }
        leaf source {
          type acl-filter-entry-source-type;
          description
            "Which embed source programmed this row (e.g. bgp-flowspec)

             CLI may display an operational alias such as bgp-fs.";
        }
        container nlri {
          description
            "Enter the nlri context

             BGP FlowSpec NLRI components for this embedded entry

             Operator-notation strings (for example '[ >= 100 ] and [ <200 ]') that allow an operator or a controller such as Deepfield to correlate a generated FlowSpec rule to this filter row and its statistics. Populated only when source is bgp-flowspec. Components that do not apply to the acl-filter type or are absent from the route are omitted.";
          leaf destination-prefix {
            type string {
              length "1..24";
            }
            description
              "FlowSpec destination-prefix component (IPv4 acl-filter)";
          }
          leaf source-prefix {
            type string {
              length "1..24";
            }
            description
              "FlowSpec source-prefix component (IPv4 acl-filter)";
          }
          leaf ipv6-destination-prefix {
            type string {
              length "1..64";
            }
            description
              "FlowSpec destination-prefix component (IPv6 acl-filter)";
          }
          leaf ipv6-source-prefix {
            type string {
              length "1..64";
            }
            description
              "FlowSpec source-prefix component (IPv6 acl-filter)";
          }
          leaf ip-protocol {
            type string {
              length "1..24";
            }
            description
              "FlowSpec IP-protocol component (IPv4 acl-filter)";
          }
          leaf upper-layer-protocol {
            type string {
              length "1..24";
            }
            description
              "FlowSpec upper-layer-protocol component (IPv6 acl-filter)";
          }
          leaf port {
            type string {
              length "1..128";
            }
            description
              "FlowSpec port component";
          }
          leaf destination-port {
            type string {
              length "1..128";
            }
            description
              "FlowSpec destination-port component";
          }
          leaf source-port {
            type string {
              length "1..128";
            }
            description
              "FlowSpec source-port component";
          }
          leaf icmp-type {
            type string {
              length "1..24";
            }
            description
              "FlowSpec ICMP-type component (IPv4 acl-filter)";
          }
          leaf icmp-code {
            type string {
              length "1..917";
            }
            description
              "FlowSpec ICMP-code component (IPv4 acl-filter)

               List of the matched ICMP code values in ascending order, for example '[ 0 1 ]'.";
          }
          leaf icmpv6-type {
            type string {
              length "1..24";
            }
            description
              "FlowSpec ICMPv6-type component (IPv6 acl-filter)";
          }
          leaf icmpv6-code {
            type string {
              length "1..917";
            }
            description
              "FlowSpec ICMPv6-code component (IPv6 acl-filter)

               List of the matched ICMPv6 code values in ascending order, for example '[ 0 1 ]'.";
          }
          leaf tcp-flags {
            type string {
              length "1..128";
            }
            description
              "FlowSpec TCP-flags component";
          }
          leaf packet-length {
            type string {
              length "1..128";
            }
            description
              "FlowSpec packet-length component";
          }
          leaf dscp {
            type string {
              length "1..185";
            }
            description
              "FlowSpec DSCP component

               List of the matched DSCP values in ascending order, for example '[ 10 12 ]'.";
          }
          leaf fragment {
            type string {
              length "1..128";
            }
            description
              "FlowSpec fragment component (IPv4 acl-filter)";
          }
          leaf flow-label {
            type string {
              length "1..24";
            }
            description
              "FlowSpec flow-label component (IPv6 acl-filter)";
          }
        }
        container action {
          description
            "Enter the action context

             Action programmed in hardware for this embedded entry";
          choice action {
            description
              "Exactly one of these is populated, reflecting the single action decoded from the FlowSpec route";
            container accept {
              presence "accept";
              description
                "Enter the accept context

                 Accept matching packets and forward them towards their normal destination, optionally redirected";
              container forward {
                description
                  "Enter the forward context

                   Populated only when BGP requested redirection to a next hop or a routing context; omitted for a plain accept.";
                choice forward-action {
                  container next-hop {
                    description
                      "Enter the next-hop context";
                    leaf address {
                      type srl-comm:ip-address;
                      description
                        "IP address of the next hop received from BGP";
                    }
                    leaf network-instance {
                      type leafref {
                        path "/srl-netinst:network-instance/srl-netinst:name";
                      }
                      description
                        "Routing context resolved from the virtual-router identifier received from BGP alongside the next hop.";
                    }
                  }
                  leaf network-instance {
                    type leafref {
                      path "/srl-netinst:network-instance/srl-netinst:name";
                    }
                    description
                      "Routing context resolved from the virtual-router identifier received from BGP";
                  }
                }
              }
            }
            container drop {
              presence "drop";
              description
                "Enter the drop context

                 Drop matching packets";
            }
          }
          leaf collect-stats {
            if-feature "srl-feat:acl-filter-embed-collect-stats";
            type boolean;
            description
              "Whether statistics are collected for packets matching this entry";
          }
          leaf log {
            type boolean;
            description
              "Whether packets matching this entry are logged";
          }
        }
        uses acl-filter-entry-statistics;
        uses interface-filter-entry-tcam;
      }
    }
  }

  grouping common-acl-filter-entry-match-l2-config {
    srl-exts:delivery-node-override "false";
    description
      "Container for the conditions that determine whether an Ethernet frame matches this entry";
    container destination-mac {
      description
        "Enter the destination-mac context

         Ethernet frame matching criteria based on destination MAC address";
      leaf address {
        description
          "Match an Ethernet frame if its destination MAC address logically anded with the mask equals this MAC address.";
        type srl-comm:mac-address;
        must "../mask >= ''" {
          error-message "A mask must be configured to use with the address";
        }
        must "string(../../../../../type) = 'mac'" {
          error-message "The acl-filter must be of type mac";
        }
      }
      leaf mask {
        description
          "Match an Ethernet frame if its destination MAC address logically anded with the mask equals the configured MAC address.";
        type srl-comm:mac-address;
        must "../address >= ''" {
          error-message "An address must be configured to use with the mask";
        }
        must "string(../../../../../type) = 'mac'" {
          error-message "The acl-filter must be of type mac";
        }
      }
    }
    leaf ethertype {
      description
        "An Ethernet frame matches this condition if its ethertype value (after 802.1Q VLAN tags) matches the specified value";
      type srl-pkt-matc-type:ethertype;
      must "string(../../../../type) = 'mac'" {
        error-message "The acl-filter must be of type mac";
      }
    }
    container source-mac {
      description
        "Enter the source-mac context

         Ethernet frame matching criteria based on source MAC address";
      leaf address {
        description
          "Match an Ethernet frame if its source MAC address logically anded with the mask equals this MAC address.";
        type srl-comm:mac-address;
        must "../mask >= ''" {
          error-message "A mask must be configured to use with the address";
        }
        must "string(../../../../../type) = 'mac'" {
          error-message "The acl-filter must be of type mac";
        }
      }
      leaf mask {
        description
          "Match an Ethernet frame if its source MAC address logically anded with the mask equals the configured MAC address.";
        type srl-comm:mac-address;
        must "../address >= ''" {
          error-message "An address must be configured to use with the mask";
        }
        must "string(../../../../../type) = 'mac'" {
          error-message "The acl-filter must be of type mac";
        }
      }
    }
    container vlan {
      description
        "Enter the vlan context

         Ethernet frame matching criteria based on VLAN tags";
      container outermost-vlan-id {
        description
          "Enter the outermost-vlan-id context

           Ethernet frame matching criteria based on the outermost VLAN ID found before the subinterface-defining VLAN tag (if any) is removed.";
        choice vlan-matching-type {
          case range-with-one-value {
            leaf operator {
              description
                "Comparison operator

                 eq = equal
                 ge = greater than or equal to
                 le = less than or equal to";
              type srl-pkt-matc-type:operator;
              must "string(../../../../../../type) = 'mac'" {
                error-message "The acl-filter must be of type mac";
              }
            }
            leaf value {
              description
                "A VLAN ID number

                 A value of zero is used to match priority-tagged 802.1Q frames.";
              type srl-pkt-matc-type:vlan-id-type;
              must "string(../../../../../../type) = 'mac'" {
                error-message "The acl-filter must be of type mac";
              }
            }
          }
          case range-with-two-values {
            container range {
              description
                "Enter the range context

                 Container used to specify a contiguous range of VLAN IDs. Matched values include the start and end values.";
              leaf start {
                type srl-pkt-matc-type:vlan-id-type;
                description
                  "The starting VLAN ID to include in the range";
                must '../end >= .' {
                  error-message "The end must be greater than start";
                }
                must "string(../../../../../../../type) = 'mac'" {
                  error-message "The acl-filter must be of type mac";
                }
              }
              leaf end {
                type srl-pkt-matc-type:vlan-id-type;
                description
                  "The ending VLAN ID to include in the range";
                must '../start <= .' {
                  error-message "The end must be greater than start";
                }
                must "string(../../../../../../../type) = 'mac'" {
                  error-message "The acl-filter must be of type mac";
                }
              }
            }
          }
          case special-value-none-to-match-untagged {
            leaf none {
              type empty;
              description
                "When configured, only untagged frames are matched.";
              must "string(../../../../../../type) = 'mac'" {
                error-message "The acl-filter must be of type mac";
              }
            }
          }
        }
      }
    }
  }

  grouping common-acl-filter-entry-match-layer4-config {
    description
      "ACL entry common layer 4 fields";
    container destination-port {
      description
        "Enter the destination-port context

         A packet matches this condition if its destination TCP or UDP port number matches the value or range or within the port-lists that is specified

         The rule should also have a condition that the IP protocol equals 6 (TCP) or 17 (UDP) in order for this to be interpreted correctly.";
      choice port {
        case value {
          leaf operator {
            description
              "Comparison operator

               eq = equal
               ge = greater than or equal to
               le = less than or equal to";
            type srl-pkt-matc-type:operator;
            must "string(../value) != ''" {
              error-message "The destination port value must be specified along with operator";
            }
            must "string(../../../../../type) = 'ipv4' or string(../../../../../type) = 'ipv6'" {
              error-message "The acl-filter must be of type ipv4 or ipv6";
            }
          }
          leaf value {
            description
              "A destination port number";
            type srl-pkt-matc-type:l4-port-type;
            must "string(../../../ipv4/protocol) = '6' or string(../../../ipv6/next-header) = '6' or string(../../../ipv4/protocol) = '17' or
                  string(../../../ipv6/next-header) = '17' or string(../../../ipv4/protocol) = 'tcp' or string(../../../ipv6/next-header) = 'tcp' or
                  string(../../../ipv4/protocol) = 'udp' or string(../../../ipv6/next-header) = 'udp'" {
              error-message "The protocol or next-header must be TCP or UDP to use port value";
            }
            must "string(../../../ipv4/fragment) = '' or string(../../../ipv4/first-fragment = true())" {
              error-message "The first-fragment must be true to use port value with fragment";
            }
            must "string(../../../../../type) = 'ipv4' or string(../../../../../type) = 'ipv6'" {
              error-message "The acl-filter must be of type ipv4 or ipv6";
            }
          }
        }
        case range {
          container range {
            description
              "Enter the range context

               Container used to specify a contiguous range of TCP/UDP port numbers";
            leaf start {
              type srl-pkt-matc-type:l4-port-type;
              description
                "The starting port number to include in the range";
              must "not(../../operator >= '')" {
                error-message "The destination port operator must be empty to use range";
              }
              must "string(../../value) = ''" {
                error-message "The destination port value must be empty to use range";
              }
              must "string(../../../../ipv4/protocol) = '6' or string(../../../../ipv6/next-header) = '6' or string(../../../../ipv4/protocol) = '17' or
                    string(../../../../ipv6/next-header) = '17' or string(../../../../ipv4/protocol) = 'tcp' or string(../../../../ipv6/next-header) = 'tcp' or
                    string(../../../../ipv4/protocol) = 'udp' or string(../../../../ipv6/next-header) = 'udp'" {
                error-message "The protocol or next-header must be TCP or UDP to use port value";
              }
              must "string(../../../../ipv4/fragment) = '' or string(../../../../ipv4/first-fragment = true())" {
                error-message "The first-fragment must be true to use port value with fragment";
              }
              must "string(../../../../../../type) = 'ipv4' or string(../../../../../../type) = 'ipv6'" {
                error-message "The acl-filter must be of type ipv4 or ipv6";
              }
            }
            leaf end {
              type srl-pkt-matc-type:l4-port-type;
              description
                "The ending port number to include in the range";
              must "not(../../operator >= '')" {
                error-message "The destination port operator must be empty to use range";
              }
              must "string(../../value) = ''" {
                error-message "The destination port value must be empty to use range";
              }
              must "string(../../../../ipv4/protocol) = '6' or string(../../../../ipv6/next-header) = '6' or string(../../../../ipv4/protocol) = '17' or
                    string(../../../../ipv6/next-header) = '17' or string(../../../../ipv4/protocol) = 'tcp' or string(../../../../ipv6/next-header) = 'tcp' or
                    string(../../../../ipv4/protocol) = 'udp' or string(../../../../ipv6/next-header) = 'udp'" {
                error-message "The protocol or next-header must be TCP or UDP to use port value";
              }
              must "string(../../../../ipv4/fragment) = '' or string(../../../../ipv4/first-fragment = true())" {
                error-message "The first-fragment must be true to use port value with fragment";
              }
              must "string(../../../../../../type) = 'ipv4' or string(../../../../../../type) = 'ipv6'" {
                error-message "The acl-filter must be of type ipv4 or ipv6";
              }
            }
          }
        }
        case port-list {
          list port-list {
            if-feature "srl-feat:acl-l4-port-list";
            key "name";
            max-elements 1;
            description
              "Name of the port list";
            leaf name {
              type leafref {
                path "/srl-acl:acl/srl-acl:match-list/srl-acl:port-list/srl-acl:name";
              }
              must "string(../../../../ipv4/protocol) = '6' or string(../../../../ipv6/next-header) = '6' or string(../../../../ipv4/protocol) = '17' or
                    string(../../../../ipv6/next-header) = '17' or string(../../../../ipv4/protocol) = 'tcp' or string(../../../../ipv6/next-header) = 'tcp' or
                    string(../../../../ipv4/protocol) = 'udp' or string(../../../../ipv6/next-header) = 'udp'" {
                error-message "The protocol or next-header must be TCP or UDP to use port value";
              }
              must "string(../../../../ipv4/fragment) = '' or string(../../../../ipv4/first-fragment = true())" {
                error-message "The first-fragment must be true to use port value with fragment";
              }
              must "string(../../../../../../type) = 'ipv4' or string(../../../../../../type) = 'ipv6'" {
                error-message "The acl-filter must be of type ipv4 or ipv6";
              }
            }
          }
        }
      }
    }
    container source-port {
      description
        "Enter the source-port context

         A packet matches this condition if its source TCP or UDP port number matches the value or range or within the port-lists that is specified

         The rule should also have a condition that the IP protocol equals 6 (TCP) or 17 (UDP) in order for this to be interpreted correctly.";
      choice port {
        case value {
          leaf operator {
            description
              "Comparison operator

               eq = equal
               ge = greater than or equal to
               le = less than or equal to";
            type srl-pkt-matc-type:operator;
            must "string(../value) != ''" {
              error-message "The source port value must be specified along with operator";
            }
            must "string(../../../../../type) = 'ipv4' or string(../../../../../type) = 'ipv6'" {
              error-message "The acl-filter must be of type ipv4 or ipv6";
            }
          }
          leaf value {
            description
              "A source port number";
            type srl-pkt-matc-type:l4-port-type;
            must "string(../../../ipv4/protocol) = '6' or string(../../../ipv6/next-header) = '6' or string(../../../ipv4/protocol) = '17' or
                  string(../../../ipv6/next-header) = '17' or string(../../../ipv4/protocol) = 'tcp' or string(../../../ipv6/next-header) = 'tcp' or
                  string(../../../ipv4/protocol) = 'udp' or string(../../../ipv6/next-header) = 'udp'" {
              error-message "The protocol or next-header must be TCP or UDP to use port value";
            }
            must "string(../../../ipv4/fragment) = '' or string(../../../ipv4/first-fragment = true())" {
              error-message "The first-fragment must be true to use port value with fragment";
            }
            must "string(../../../../../type) = 'ipv4' or string(../../../../../type) = 'ipv6'" {
              error-message "The acl-filter must be of type ipv4 or ipv6";
            }
          }
        }
        case range {
          container range {
            description
              "Enter the range context

               Container used to specify a contiguous range of TCP/UDP port numbers";
            leaf start {
              type srl-pkt-matc-type:l4-port-type;
              description
                "The starting port number to include in the range";
              must "string(../../value) = ''" {
                error-message "The source port value must not be set to use range";
              }
              must "not(../../operator >= '')" {
                error-message "The source port operator must be empty to use range";
              }
              must "string(../../../../ipv4/protocol) = '6' or string(../../../../ipv6/next-header) = '6' or string(../../../../ipv4/protocol) = '17' or
                    string(../../../../ipv6/next-header) = '17' or string(../../../../ipv4/protocol) = 'tcp' or string(../../../../ipv6/next-header) = 'tcp' or
                    string(../../../../ipv4/protocol) = 'udp' or string(../../../../ipv6/next-header) = 'udp'" {
                error-message "The protocol or next-header must be TCP or UDP to use port value";
              }
              must "string(../../../../ipv4/fragment) = '' or string(../../../../ipv4/first-fragment = true())" {
                error-message "The first-fragment must be true to use port value with fragment";
              }
              must "string(../../../../../../type) = 'ipv4' or string(../../../../../../type) = 'ipv6'" {
                error-message "The acl-filter must be of type ipv4 or ipv6";
              }
            }
            leaf end {
              type srl-pkt-matc-type:l4-port-type;
              description
                "The ending port number to include in the range";
              must "string(../../value) = ''" {
                error-message "The source port value must not be set to use range";
              }
              must "not(../../operator >= '')" {
                error-message "The source port operator must be empty to use range";
              }
              must "string(../../../../ipv4/protocol) = '6' or string(../../../../ipv6/next-header) = '6' or string(../../../../ipv4/protocol) = '17' or
                    string(../../../../ipv6/next-header) = '17' or string(../../../../ipv4/protocol) = 'tcp' or string(../../../../ipv6/next-header) = 'tcp' or
                    string(../../../../ipv4/protocol) = 'udp' or string(../../../../ipv6/next-header) = 'udp'" {
                error-message "The protocol or next-header must be TCP or UDP to use port value";
              }
              must "string(../../../../ipv4/fragment) = '' or string(../../../../ipv4/first-fragment = true())" {
                error-message "The first-fragment must be true to use port value with fragment";
              }
              must "string(../../../../../../type) = 'ipv4' or string(../../../../../../type) = 'ipv6'" {
                error-message "The acl-filter must be of type ipv4 or ipv6";
              }
            }
          }
        }
        case port-list {
          list port-list {
            if-feature "srl-feat:acl-l4-port-list";
            key "name";
            max-elements 1;
            description
              "Name of the port list";
            leaf name {
              type leafref {
                path "/srl-acl:acl/srl-acl:match-list/srl-acl:port-list/srl-acl:name";
              }
              must "string(../../../../ipv4/protocol) = '6' or string(../../../../ipv6/next-header) = '6' or string(../../../../ipv4/protocol) = '17' or
                    string(../../../../ipv6/next-header) = '17' or string(../../../../ipv4/protocol) = 'tcp' or string(../../../../ipv6/next-header) = 'tcp' or
                    string(../../../../ipv4/protocol) = 'udp' or string(../../../../ipv6/next-header) = 'udp'" {
                error-message "The protocol or next-header must be TCP or UDP to use port value";
              }
              must "string(../../../../ipv4/fragment) = '' or string(../../../../ipv4/first-fragment = true())" {
                error-message "The first-fragment must be true to use port value with fragment";
              }
              must "string(../../../../../../type) = 'ipv4' or string(../../../../../../type) = 'ipv6'" {
                error-message "The acl-filter must be of type ipv4 or ipv6";
              }
            }
          }
        }
      }
    }
    leaf tcp-flags {
      type string {
        pattern '(\(|\)|&|\||!|ack|rst|syn)+';
        length "1..255";
      }
      must "string(../../ipv4/protocol) = '6' or string(../../ipv4/protocol) = 'tcp' or string(../../ipv6/next-header) = '6' or string(../../ipv6/next-header) = 'tcp'" {
        error-message "A protocol or next-header must be TCP to use with tcp flags";
      }
      must "(string(../../ipv4/fragment) = '' and string(../../ipv4/first-fragment) = '') or (../../ipv4/first-fragment = true()) or string(../../ipv6/next-header) != ''" {
        error-message "The first-fragment must be true to use tcp-flags with fragment";
      }
      must "string(../../../../type) = 'ipv4' or string(../../../../type) = 'ipv6'" {
        error-message "The acl-filter must be of type ipv4 or ipv6";
      }
      description
        "A logical expression using the &, | and ! logical operators and the TCP flag names: rst, syn and ack.";
    }
  }

  grouping common-acl-filter-entry-match-ipv4-config {
    srl-exts:delivery-node-override "false";
    description
      "Container for the conditions that determine whether a packet matches this entry";
    container destination-ip {
      description
        "Enter the destination-ip context

         Packet matching criteria based on destination IPv4 address";
      leaf prefix {
        description
          "Match a packet if its destination IP address is within the specified IPv4 prefix.";
        type srl-comm:ipv4-prefix;
        must "not(../address >= '' or ../mask >= '')" {
          error-message "An address and mask must be empty to use the address with prefix";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
      list prefix-list {
        if-feature "srl-feat:acl-ip-prefix-list";
        key "name";
        max-elements 8;
        description
          "Match a packet if its destination IP address is within the specified IPv4 prefix list.";
        leaf name {
          type leafref {
            path "/srl-acl:acl/srl-acl:match-list/srl-acl:ipv4-prefix-list/srl-acl:name";
          }
        }
        must "not(../address >= '' or ../mask >= '' or ../prefix >= '')" {
          error-message "An address, mask and prefix must be empty to use the address with prefix-list";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
      leaf address {
        description
          "Match a packet if its destination IP address logically anded with the inverse of the mask equals this IP address.";
        type srl-comm:ipv4-address;
        must "../mask >= ''" {
          error-message "An inverse mask must be configured to use with the address";
        }
        must "not(../prefix >= '')" {
          error-message "A prefix must be empty to use the address with mask";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
      leaf mask {
        description
          "Match a packet if its destination IP address logically anded with the inverse of this mask equals the configured IP address logically anded with the inverse of this mask.";
        type srl-comm:ipv4-address;
        must "../address >= ''" {
          error-message "An address must be configured to use with the mask";
        }
        must "not(../prefix = '')" {
          error-message "A prefix must be empty to use the address with mask";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
    }
    leaf-list dscp-set {
      if-feature "srl-feat:ip-acl-dscp-set";
      type srl-comm:dscp;
      description
        "A list of DSCP values to be matched for incoming packets. An OR match should be performed, such that a packet must match one of the values defined in this list. If the field is left empty then any DSCP value matches.";
      must "string(../../../../type) = 'ipv4'" {
        error-message "The acl-filter must be of type ipv4";
      }
    }
    leaf fragment {
      type boolean;
      description
        "Match an IPv4 fragment

         A packet matches the true condition if the IPv4 header indicates that the fragment-offset is zero and and the more-fragments bit is 1 or if the IPv4 header indicates that the fragment-offset is greater than 0. A packet matches the false condition if it is unfragmented.";
      must "string(../../../../type) = 'ipv4'" {
        error-message "The acl-filter must be of type ipv4";
      }
    }
    leaf first-fragment {
      type boolean;
      description
        "Match the first fragment of an IPv4 datagram

         A packet matches the true condition if the IPv4 header indicates that the fragment-offset is zero
         and and the more-fragments bit is 1. It is not valid to configure this leaf without configuring a
         match value for the fragment leaf.";
      must '../fragment = true()' {
        error-message "When the first-fragment is configured, fragment should be configured";
      }
      must "string(../../../../type) = 'ipv4'" {
        error-message "The acl-filter must be of type ipv4";
      }
    }
    leaf ip-option-present {
      if-feature "srl-feat:acl-ip-option-present";
      type boolean;
      description
        "Match a packet if it contains an IPv4 IP option.";
      must "string(../../../../type) = 'ipv4'" {
        error-message "The acl-filter must be of type ipv4";
      }
    }
    container icmp {
      description
        "Enter the icmp context

         A packet matches this condition if its ICMP type and code matches one of the specified combinations

         The rule should also have a condition that the IP protocol equals 1 (ICMP) in order for this to be interpreted correctly.";
      leaf type {
        description
          "Match a single ICMP type value.";
        type srl-pkt-matc-type:icmp-type;
        must "string(../../protocol) = '1' or string(../../protocol) = 'icmp'" {
          error-message "The protocol should be 1 or ICMP to use ICMP type";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
      leaf-list code {
        description
          "Match if the ICMP code value is any value in the list

           Requires ICMP type to be specified because codes are type dependent.";
        type uint8;
        must "string(../../protocol) = '1' or string(../../protocol) = 'icmp'" {
          error-message "The protocol should be 1 or ICMP to use ICMP type";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
    }
    leaf protocol {
      description
        "An IPv4 packet matches this condition if its IP protocol type field matches the specified value";
      type srl-pkt-matc-type:ip-protocol-type;
      must "string(../../../../type) = 'ipv4'" {
        error-message "The acl-filter must be of type ipv4";
      }
    }
    container source-ip {
      description
        "Enter the source-ip context

         Packet matching criteria based on source IPv4 address";
      leaf prefix {
        description
          "Match a packet if its source IP address is within the specified IPv4 prefix.";
        type srl-comm:ipv4-prefix;
        must "not(../address >= '' or ../mask >= '')" {
          error-message "An address and mask must be empty to use the address with prefix";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
      list prefix-list {
        if-feature "srl-feat:acl-ip-prefix-list";
        key "name";
        max-elements 8;
        description
          "Match a packet if its source IP address is within the specified IPv4 prefix list.";
        leaf name {
          type leafref {
            path "/srl-acl:acl/srl-acl:match-list/srl-acl:ipv4-prefix-list/srl-acl:name";
          }
        }
        must "not(../address >= '' or ../mask >= '' or ../prefix >= '')" {
          error-message "An address, mask and prefix must be empty to use the address with prefix-list";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
      leaf address {
        description
          "Match a packet if its source IP address logically anded with the inverse of the mask equals this IP address.";
        type srl-comm:ipv4-address;
        must "../mask >= ''" {
          error-message "An inverse mask must be configured to use with the address";
        }
        must "not(../prefix >= '')" {
          error-message "A prefix must be empty to use the address with mask";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
      leaf mask {
        description
          "Match a packet if its source IP address logically anded with the inverse of this mask equals the configured IP address logically anded with the inverse of this mask.";
        type srl-comm:ipv4-address;
        must "../address >= ''" {
          error-message "An address must be configured to use with the mask";
        }
        must "not(../prefix >= '')" {
          error-message "A prefix must be empty to use the address with mask";
        }
        must "string(../../../../../type) = 'ipv4'" {
          error-message "The acl-filter must be of type ipv4";
        }
      }
    }
    container packet-length {
      if-feature "srl-feat:acl-ip-packet-length";
      description
        "Enter the packet-length context

         A packet matches this condition if its packet-length matches the value or range or within the ipv4-packet-length-lists that is specified";
      choice packet-length {
        case value {
          leaf operator {
            description
              "Comparison operator
               eq = equal
               ge = greater than or equal to
               le = less than or equal to";
            type srl-pkt-matc-type:operator;
            must "string(../value) != ''" {
              error-message "The packet-length value must be specified along with operator";
            }
          }
          leaf value {
            description
              "A ip-packet-length value";
            type uint32 {
              range "0..65535";
            }
          }
        }
        case range {
          container range {
            description
              "Enter the range context

               Container used to specify a contiguous range of ip-packet-length values";
            leaf start {
              type uint32 {
                range "0..65535";
              }
              description
                "The starting packet-length value to include in the range";
              must "string(../end) != ''" {
                error-message "The packet-length end value must also be specified to use range";
              }
              must '../end >= .' {
                error-message "The packet-length end value must be greater than start";
              }
            }
            leaf end {
              type uint32 {
                range "0..65535";
              }
              description
                "The ending packet-length value to include in the range";
              must "string(../start) != ''" {
                error-message "The packet-length start value must also be specified to use range";
              }
              must '../start <= .' {
                error-message "The packet-length end value must be greater than start";
              }
            }
          }
        }
        case ipv4-packet-length-list {
          list packet-length-list {
            if-feature "srl-feat:acl-ip-packet-length";
            key "name";
            max-elements 1;
            description
              "Name of the Ipv4 packet length list";
            leaf name {
              type leafref {
                path "/srl-acl:acl/srl-acl:match-list/srl-acl:ipv4-packet-length-list/srl-acl:name";
              }
            }
          }
        }
      }
    }
    container ttl {
      if-feature "srl-feat:acl-ttl";
      description
        "Enter the ttl context

         A packet matches this condition if its IPv4 TTL value matches the value or range that is specified.";
      choice ttl-match-type {
        case value {
          leaf operator {
            description
              "Comparison operator

               eq = equal
               ge = greater than or equal to
               le = less than or equal to";
            type srl-pkt-matc-type:operator;
            must "string(../value) != ''" {
              error-message "The TTL value must be specified along with operator";
            }
            must "string(../../../../../type) = 'ipv4' " {
              error-message "The acl-filter must be of type ipv4";
            }
          }
          leaf value {
            description
              "A TTL value number";
            type uint8;
            must "string(../../../../../type) = 'ipv4' " {
              error-message "The acl-filter must be of type ipv4";
            }
          }
        }
        case range {
          container range {
            description
              "Enter the range context

               Container used to specify a contiguous range of TTL values";
            leaf start {
              type uint8;
              description
                "The starting TTL value number to include in the range";
              must "string(../../value) = ''" {
                error-message "The value field must not be set to use range";
              }
              must "not(../../operator >= '')" {
                error-message "The operator field must not be set to use range";
              }
              must "string(../../../../../../type) = 'ipv4' " {
                error-message "The acl-filter must be of type ipv4";
              }
            }
            leaf end {
              type uint8;
              description
                "The ending TTL value number to include in the range";
              must "string(../../value) = ''" {
                error-message "The value field must not be set to use range";
              }
              must "not(../../operator >= '')" {
                error-message "The operator field must not be set to use range";
              }
              must "string(../../../../../../type) = 'ipv4' " {
                error-message "The acl-filter must be of type ipv4";
              }
            }
          }
        }
      }
    }
  }

  grouping common-acl-filter-entry-match-ipv6-config {
    srl-exts:delivery-node-override "false";
    description
      "Container for the conditions that determine whether a packet matches this entry";
    container destination-ip {
      description
        "Enter the destination-ip context

         Packet matching criteria based on destination IPv6 address";
      leaf prefix {
        description
          "Match a packet if its destination IP address is within the specified IPv6 prefix.";
        type srl-comm:ipv6-prefix;
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
      list prefix-list {
        if-feature "srl-feat:acl-ip-prefix-list";
        key "name";
        max-elements 8;
        description
          "Match a packet if its destination IP address is within the specified IPv6 prefix list.";
        leaf name {
          type leafref {
            path "/srl-acl:acl/srl-acl:match-list/srl-acl:ipv6-prefix-list/srl-acl:name";
          }
        }
        must "not(../address >= '' or ../mask >= '' or ../prefix >= '')" {
          error-message "An address, mask and prefix must be empty to use the address with prefix-list";
        }
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
      leaf address {
        description
          "Match a packet if its destination IP address logically anded with the inverse of the mask equals this IP address.";
        type srl-comm:ipv6-address;
        must "../mask >= ''" {
          error-message "An inverse mask must be configured to use with the address";
        }
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
      leaf mask {
        description
          "Match a packet if its destination IP address logically anded with the inverse of this mask equals the configured IP address logically anded with the inverse of this mask.";
        type srl-comm:ipv6-address;
        must "string(../prefix) = ''" {
          error-message "A prefix must be empty to use the address with mask";
        }
        must "../address >= ''" {
          error-message "An address must be configured to use with the mask";
        }
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
    }
    leaf-list dscp-set {
      if-feature "srl-feat:ip-acl-dscp-set";
      type srl-comm:dscp;
      description
        "A list of DSCP values to be matched for incoming packets. An OR match should be performed, such that a packet must match one of the values defined in this list. If the field is left empty then any DSCP value matches.";
      must "string(../../../../type) = 'ipv6'" {
        error-message "The acl-filter must be of type ipv6";
      }
    }
    container icmp6 {
      description
        "Enter the icmp6 context

         A packet matches this condition if its ICMPv6 type and code matches one of the specified combinations

         The rule should also have a condition that the next-header value equals 58 (ICMPv6) in order for this to be interpreted correctly.";
      leaf type {
        description
          "Match a single ICMPv6 type value";
        type srl-pkt-matc-type:icmp6-type;
        must "string(../../next-header) = '58' or string(../../next-header) = 'icmp6'" {
          error-message "The next-header should be 58 or icmp6 to use icmp6 type";
        }
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
      leaf-list code {
        description
          "Match if the ICMPv6 code value is any value in the list

           Requires ICMPv6 type to be specified because codes are type dependent.";
        type uint8;
        must "string(../../next-header) = '58' or string(../../next-header) = 'icmp6'" {
          error-message "The next-header should be 58 or icmp6 to use icmp6 code";
        }
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
    }
    leaf next-header {
      description
        "An IPv6 packet matches this condition if its first next-header field (in the IPv6 fixed header) contains the specified value";
      type srl-pkt-matc-type:ip-protocol-type;
      must "string(../../../../type) = 'ipv6'" {
        error-message "The acl-filter must be of type ipv6";
      }
    }
    container source-ip {
      description
        "Enter the source-ip context

         Packet matching criteria based on source IPv6 address";
      leaf prefix {
        description
          "Match a packet if its source IP address is within the specified IPv6 prefix.";
        type srl-comm:ipv6-prefix;
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
      list prefix-list {
        if-feature "srl-feat:acl-ip-prefix-list";
        key "name";
        max-elements 8;
        description
          "Match a packet if its source IP address is within the specified IPv6 prefix list.";
        leaf name {
          type leafref {
            path "/srl-acl:acl/srl-acl:match-list/srl-acl:ipv6-prefix-list/srl-acl:name";
          }
        }
        must "not(../address >= '' or ../mask >= '' or ../prefix >= '')" {
          error-message "An address, mask and prefix must be empty to use the address with prefix-list";
        }
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
      leaf address {
        description
          "Match a packet if its source IP address logically anded with the inverse of the mask equals this IP address.";
        type srl-comm:ipv6-address;
        must "../mask >= ''" {
          error-message "An inverse mask must be configured to use with the address";
        }
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
      leaf mask {
        description
          "Match a packet if its source IP address logically anded with the inverse of this mask equals the configured IP address logically anded with the inverse of this mask.";
        type srl-comm:ipv6-address;
        must "../address >= ''" {
          error-message "An address must be configured to use with the mask";
        }
        must "string(../../../../../type) = 'ipv6'" {
          error-message "The acl-filter must be of type ipv6";
        }
      }
    }
    container packet-length {
      if-feature "srl-feat:acl-ip-packet-length";
      description
        "Enter the packet-length context

         A packet matches this condition if its packet-length matches the value or range or within the ipv6-packet-length-lists that is specified";
      choice packet-length {
        case value {
          leaf operator {
            description
              "Comparison operator
               eq = equal
               ge = greater than or equal to
               le = less than or equal to";
            type srl-pkt-matc-type:operator;
            must "string(../value) != ''" {
              error-message "The packet-length value must be specified along with operator";
            }
          }
          leaf value {
            description
              "A ip-packet-length value";
            type uint32 {
              range "40..65575";
            }
          }
        }
        case range {
          container range {
            description
              "Enter the range context

               Container used to specify a contiguous range of ip-packet-length values";
            leaf start {
              type uint32 {
                range "40..65575";
              }
              description
                "The starting packet-length value to include in the range";
              must '../end >= .' {
                error-message "The packet-length end value must be greater than start";
              }
              must "string(../end) != ''" {
                error-message "The packet-length end value must also be specified to use range";
              }
            }
            leaf end {
              type uint32 {
                range "40..65575";
              }
              description
                "The ending packet-length value to include in the range";
              must "string(../start) != ''" {
                error-message "The packet-length start value must also be specified to use range";
              }
              must '../start <= .' {
                error-message "The packet-length end value must be greater than start";
              }
            }
          }
        }
        case ipv6-packet-length-list {
          list packet-length-list {
            if-feature "srl-feat:acl-ip-packet-length";
            key "name";
            max-elements 1;
            description
              "Name of the Ipv6 packet length list";
            leaf name {
              type leafref {
                path "/srl-acl:acl/srl-acl:match-list/srl-acl:ipv6-packet-length-list/srl-acl:name";
              }
            }
          }
        }
      }
    }
    container hop-limit {
      if-feature "srl-feat:acl-ttl";
      description
        "Enter the hop-limit context

         A packet matches this condition if its IPv6 hop-limit value matches the value or range that is specified.";
      choice hop-limit-match-type {
        case value {
          leaf operator {
            description
              "Comparison operator

               eq = equal
               ge = greater than or equal to
               le = less than or equal to";
            type srl-pkt-matc-type:operator;
            must "string(../value) != ''" {
              error-message "The hop-limit value must be specified along with operator";
            }
            must "string(../../../../../type) = 'ipv6'" {
              error-message "The acl-filter must be of type ipv6";
            }
          }
          leaf value {
            description
              "A hop-limit value number";
            type uint8;
            must "string(../../../../../type) = 'ipv6'" {
              error-message "The acl-filter must be of type ipv6";
            }
          }
        }
        case range {
          container range {
            description
              "Enter the range context

               Container used to specify a contiguous range of hop-limit values";
            leaf start {
              type uint8;
              description
                "The starting hop-limit value number to include in the range";
              must "string(../../value) = ''" {
                error-message "The value field must not be set to use range";
              }
              must "not(../../operator >= '')" {
                error-message "The operator field must not be set to use range";
              }
              must "string(../../../../../../type) = 'ipv6'" {
                error-message "The acl-filter must be of type ipv6";
              }
            }
            leaf end {
              type uint8;
              description
                "The ending hop-limit value number to include in the range";
              must "string(../../value) = ''" {
                error-message "The value field must not be set to use range";
              }
              must "not(../../operator >= '')" {
                error-message "The operator field must not be set to use range";
              }
              must "string(../../../../../../type) = 'ipv6'" {
                error-message "The acl-filter must be of type ipv6";
              }
            }
          }
        }
      }
    }
  }

  grouping match-network-instance {
    leaf network-instance {
      if-feature "srl-feat:acl-cpm-filter-match-network-instance";
      type leafref {
        path "/srl-netinst:network-instance/srl-netinst:name";
      }
      must 'not(/srl-netinst:network-instance[srl-netinst:name=current()]/srl-netinst:type = "srl-netinst:mac-vrf")' {
        error-message "The network-instance cannot be of type 'mac-vrf' for IPv4/IPv6 cpm-filter";
      }
      description
        "Reference to a configured network-instance";
    }
  }

  grouping common-acl-filter-entry-match-control-traffic-config {
    leaf protocol {
      type srl-pkt-matc-type:ip-protocol-type;
      must 'not(../ethernet-type or ../llc-value)' {
        error-message "The ethernet-type and llc-value cannot be used with protocol";
      }
      description
        "Match on the IP protocol field of the system generated packet";
    }
    leaf source-port {
      type srl-pkt-matc-type:l4-port-type;
      must "string(../protocol) = '6' or string(../protocol) = '17' or string(../protocol) = 'tcp' or string(../protocol) = 'udp'" {
        error-message "The protocol must be TCP or UDP to use port value";
      }
      description
        "Match on the source TCP or UDP port number of the system generated packet

         The entry should also match on protocol equal to 6 (TCP) or 17 (UDP) for this to be interpreted correctly.";
    }
    leaf destination-port {
      type srl-pkt-matc-type:l4-port-type;
      must "string(../protocol) = '6' or string(../protocol) = '17' or string(../protocol) = 'tcp' or string(../protocol) = 'udp'" {
        error-message "The protocol must be TCP or UDP to use port value";
      }
      description
        "Match on the destination TCP or UDP port number of the system generated packet

         The entry should also match on protocol equal to 6 (TCP) or 17 (UDP) for this to be interpreted correctly.";
    }
    leaf ethernet-type {
      type srl-pkt-matc-type:ethertype;
      must 'not(../llc-value)' {
        error-message "The llc-value cannot be used with ethernet-type";
      }
      description
        "Match on the ethertype value of the system generated frame";
    }
    leaf network-instance-name {
      type leafref {
        path "/srl-netinst:network-instance/srl-netinst:name";
      }
      description
        "Match on the network-instance that originated the system generated traffic

         If this leaf is not configured, traffic originating from any network-instance is matched.";
    }
    leaf llc-value {
      type srl-comm:hex-number;
      description
        "Match on llc header value in ethernet frame

         This criteria is mainly used to identify ISIS packets, where llc-type=fe:fe:03";
    }
  }

  grouping ip-policy-forwarding-filter-entry-action-config {
    container forward {
      if-feature "srl-feat:acl-filter-redirect-to-next-hop or srl-feat:acl-filter-redirect-to-ni";
      presence "Enable the forward context";
      description
        "Enter the forward context";
      choice forward-action {
        container next-hop {
          leaf address {
            mandatory true;
            description
              "IP address of next hop to forward matching packets.";
            type srl-comm:ip-address;
          }
          leaf network-instance {
            description
              "Routing context used for route lookup";
            type leafref {
              path "/srl-netinst:network-instance/srl-netinst:name";
            }
            must '(/srl-netinst:network-instance[srl-netinst:name=current()]/srl-netinst:type = "srl-netinst:ip-vrf" or "srl-netinst:default")' {
              error-message "the redirection only operates with an existing network-instance the type of which is ip-vrf or default";
            }
          }
          description
            "Enter the next-hop context";
        }
        leaf network-instance {
          description
            "Routing context used for route lookup";
          type leafref {
            path "/srl-netinst:network-instance/srl-netinst:name";
          }
          must '(/srl-netinst:network-instance[srl-netinst:name=current()]/srl-netinst:type = "srl-netinst:ip-vrf" or "srl-netinst:default")' {
            error-message "the redirection only operates with an existing network-instance the type of which is ip-vrf or default";
          }
        }
      }
    }
  }

  grouping common-filter-entry-action-config {
    container action {
      description
        "Enter the action context

         Container for the actions to be applied to packets matching the filter entry.";
      choice action {
        container accept {
          presence "Accept matching packets and forward them towards their normal destination";
          description
            "Accept matching packets and forward them towards their normal destination";
          leaf forwarding-class {
            if-feature "srl-feat:qos and srl-feat:acl-filter-qos-forwarding-class";
            must "not (string(../../../../name) = 'system' or string(../../../../name) = 'capture')" {
              error-message "The acl-filter name must not be system or capture";
            }
            type leafref {
              path "/srl-qos:qos/srl-qos:forwarding-classes/srl-qos:forwarding-class/srl-qos:name";
            }
            description
              "The QoS forwarding class to which the packet is mapped";
          }
          leaf profile {
            if-feature "srl-feat:acl-filter-qos-profile";
            must "not (string(../../../../name) = 'system' or string(../../../../name) = 'capture')" {
              error-message "The acl-filter name must not be system or capture";
            }
            type srl-comm:classify-profile;
            description
              "The QoS profile to which the packet is mapped";
          }
          leaf dscp {
            if-feature "srl-feat:acl-filter-control-traffic";
            type srl-comm:dscp;
            must "string(../../../../type) = 'mixed'" {
              error-message "The dscp action is supported only for acl-filter of type mixed";
            }
            must '../../../match/control-traffic/protocol or ../../../match/control-traffic/source-port or ../../../match/control-traffic/destination-port' {
              error-message "The dscp action requires the entry to match on protocol, source-port or destination-port";
            }
            description
              "Mark matching system generated packets with the specified DSCP value

               This action is supported only for entries that match on protocol, source-port or destination-port. The rewrite-rules attached to the outgoing interface are not applied to these packets.";
          }
          leaf dot1p {
            if-feature "srl-feat:acl-filter-control-traffic";
            type srl-pkt-matc-type:dot1p-type;
            must "string(../../../../type) = 'mixed'" {
              error-message "The dot1p action is supported only for acl-filter of type mixed";
            }
            must '../../../match/control-traffic/ethernet-type or ../../../match/control-traffic/llc-value' {
              error-message "The dot1p action requires the entry to match on ethernet-type or llc-value";
            }
            description
              "Mark matching system generated packets with the specified 802.1p (PCP) value

               This action is supported only for entries that match on ethernet-type or llc-value. The rewrite-rules attached to the outgoing interface are not applied to these packets.";
          }
          container rate-limit {
            description
              "Enter the rate-limit context

               Rate-limit accepted packets";
            leaf system-cpu-policer {
              type leafref {
                path "/acl/policers/system-cpu-policer/name";
              }
              description
                "Reference to a system-cpu-policer.";
              must "not (string(../../../../../name) = 'system' or string(../../../../../name) = 'capture')" {
                error-message "The acl-filter name must not be system or capture";
              }
            }
            leaf policer {
              if-feature "srl-feat:acl-policer";
              type leafref {
                path "/acl/policers/policer/name";
              }
              description
                "Reference to a policer";
              must "not (string(../../../../../name) = 'system' or string(../../../../../name) = 'capture')" {
                error-message "The acl-filter name must not be system or capture";
              }
            }
            must "not(../../../../type ='mac') or (string(policer) = '' and string(system-cpu-policer) = '')" {
              srl-exts:if-feature "not srl-feat:acl-policer-for-mac-filters";
              error-message "On the current platform, rate-limit action is not supported for acl-filter type 'mac'";
            }
          }
          uses ip-policy-forwarding-filter-entry-action-config;
        }
        container drop {
          must "not (string(../../../name) = 'capture')" {
            error-message "The acl-filter name must not be capture";
          }
          presence "Drop matching packets";
          description
            "Drop matching packets.

             Dropped IP packets do not result in sending ICMP messages back to the source";
        }
        container copy {
          if-feature "not srl-feat:fpcx";
          must "string(../../../name) = 'capture'" {
            error-message "The acl-filter name must be capture";
          }
          presence "Create a copy of matching packets extract them to the CPM and deliver them to the designated veth interface";
          description
            "Create a copy of matching packets extract them to the CPM and deliver them to the designated veth interface";
        }
        container reject {
          if-feature "srl-feat:acl-filter-reject";
          must "not (string(../../../name) = 'capture')" {
            error-message "The acl-filter name must not be capture";
          }
          must "not(string(../../../type) = 'mac')" {
            error-message "Reject action is not supported for acl-filter type 'mac'";
          }
          must "not(/srl-acl:acl/ipv4-tcam-action-profile = 'bgp-flowspec-redirect' and string(../../../type) = 'ipv4' and not(string(../../../name) = 'cpm'))" {
            srl-exts:if-feature "srl-feat:acl-ipv4-tcam-action-profile";
            error-message "IPv4 ACL reject action is not supported when acl ipv4-tcam-action-profile is bgp-flowspec-redirect";
          }
          presence "Reject matching packets";
          description
            "Reject matching packets.

             Rejected IP packets are dropped and ICMP response is messaged back to the source";
          choice response {
            leaf v4-message-type {
              type enumeration {
                enum host-unreachable {
                  value 1;
                }
                enum protocol-unreachable {
                  value 2;
                }
                enum port-unreachable {
                  value 3;
                }
                enum source-host-isolated {
                  value 8;
                }
                enum destination-network-prohibited {
                  value 9;
                }
                enum destination-host-prohibited {
                  value 10;
                }
                enum administratively-prohibited {
                  value 13;
                }
              }
              default "administratively-prohibited";
              description
                "list of Icmp Destination Unreachable code types";
              must "string(../../../../type) = 'ipv4'" {
                error-message "acl-filter must be of type ipv4 for v4 icmp reject codes";
              }
            }
            leaf v6-message-type {
              type enumeration {
                enum administratively-prohibited {
                  value 1;
                }
                enum source-address-failed {
                  value 5;
                }
                enum reject-route {
                  value 6;
                }
              }
              default "administratively-prohibited";
              description
                "list of Icmpv6 Destination Unreachable code types";
              must "string(../../../../type) = 'ipv6'" {
                error-message "acl-filter must be of type ipv6 for v6 icmp reject codes";
              }
            }
          }
        }
      }
      leaf collect-stats {
        if-feature "srl-feat:fpcx";
        must "not (string(../../../name) = 'system' or string(../../../name) = 'capture') or . = false()" {
          error-message "The acl-filter name must not be system or capture";
        }
        type boolean;
        default "false";
        description
          "Collect statistics for each entry of the ACL. If this is set to false no hardware resources are allocated to collecting statistics for this ACL entry.";
      }
      leaf log {
        if-feature "srl-feat:acl-logging";
        must "not(/srl-acl:acl/ipv4-tcam-action-profile = 'bgp-flowspec-redirect' and string(../../../type) = 'ipv4' and not(string(../../../name) = 'cpm') and . = true())" {
          srl-exts:if-feature "srl-feat:acl-ipv4-tcam-action-profile";
          error-message "IPv4 ACL log is not supported when acl ipv4-tcam-action-profile is bgp-flowspec-redirect";
        }
        must "not (string(../../../name) = 'capture') or . = false()" {
          error-message "The acl-filter name must not be system or capture";
        }
        must '(. = false()) or ../../action/accept or ../../action/drop or ../../action/reject or ../../action/copy' {
          error-message "Logging is supported only with actions drop and reject";
          srl-exts:if-feature "not srl-feat:acl-action-accept-with-log";
        }
        must 'not (. = true() and ../../action/accept)' {
          error-message "Logging is not supported with action accept";
          srl-exts:if-feature "not srl-feat:acl-action-accept-with-log";
        }
        must 'not (. = true() and ../../action/accept/rate-limit/system-cpu-policer)' {
          error-message "Invalid action (log & policer) specified";
          srl-exts:if-feature "not srl-feat:acl-logging-fpcx";
        }
        default "false";
        type boolean;
        description
          "When this is true, a log is created for each packet matching the entry

           For IP packets matched by an IP filter entry the log entry contains the following information:
           - timestamp
           - filter name
           - filter entry sequence-id
           - incoming subinterface name
           - action: drop
           - IP protocol
           - packet-length
           - source IP address
           - source L4 port number (TCP/UDP packets)
           - destination IP address
           - destination L4 port number (TCP/UDP packets)
           - icmp-type (ICMP packets)
           - icmp-code (ICMP packets)";
      }
    }
  }

  grouping acl-policer-statistics {
    description
      "ACL policer statistics";
    leaf conforming-packets {
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered conforming by the policer";
    }
    leaf conforming-octets {
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered conforming by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
    leaf exceeding-packets {
      srl-exts:show-importance "high";
      type srl-comm:zero-based-counter64;
      description
        "The number of packets (actually Ethernet frames) that were considered exceeding by the policer";
    }
    leaf exceeding-octets {
      type srl-comm:zero-based-counter64;
      description
        "The number of bytes that were considered exceeding by the policer. The byte count includes 18 bytes of Ethernet overhead for every IP packet.";
    }
  }

  grouping acl-filter-entry-statistics {
    description
      "ACL entry statistics";
    container statistics {
      description
        "Enter the statistics context

         Container for per-entry statistics";
      config false;
      srl-exts:delivery-node-override "true";
      leaf last-clear {
        type srl-comm:date-and-time-delta;
        description
          "Time of the last clear command performed by the user at this level or a higher level";
      }
      leaf incomplete {
        type boolean;
        description
          "Returns true when at least one linecard had insufficient stats resources to ensure an accurate set of values for the number of matched packets, or when not all forwarding complexes reported their counts after control plane switchover.";
      }
      leaf matched-packets {
        srl-exts:show-importance "high";
        description
          "The number of packets matching the entry since it was programmed or since the last clear, considering the mgmt0 subinterface and all subinterfaces of all linecard ports that use the ACL as an input ACL";
        type srl-comm:zero-based-counter64;
      }
      leaf matched-octets {
        srl-exts:show-importance "high";
        if-feature "srl-feat:fpcx";
        description
          "The number of octets packets matching the entry since it was programmed or since the last clear, considering the mgmt0 subinterface and all subinterfaces of all linecard ports that use the ACL as an input ACL";
        type srl-comm:zero-based-counter64;
      }
      leaf last-match {
        srl-exts:show-importance "high";
        description
          "The elapsed time since a packet last matched the entry, considering the mgmt0 subinterface and all subinterfaces of all linecard ports that use the ACL as an input ACL";
        type srl-comm:date-and-time-delta;
      }
      container policer {
        srl-exts:delivery-node-override "true";
        if-feature "srl-feat:acl-policer and not srl-feat:vsrl";
        description
          "Enter the policer context

           Policer stats for traffic matching the entry:

           Statistics for policer configured with scope=global and entry-specific=true, and acl configured with subinterface-specific=false.";
        uses acl-policer-statistics;
      }
      container system-cpu-policer {
        srl-exts:delivery-node-override "true";
        description
          "Enter the system-cpu-policer context

           System CPU policer stats for traffic matching the entry:

           Statistics for system cpu policer configured with scope=global and entry-specific=true, and acl configured with subinterface-specific=false.";
        uses acl-policer-statistics;
      }
      action clear {
        srl-exts:telemetry-capability "unsupported";
        if-feature "srl-feat:tools-as-modeled-actions-same-io";
        description
          "Execute the clear action

           Reset all aggregate and per-interface statistics associated with this particular entry to zero";
      }
    }
  }

  grouping acl-subinterface-entry-match-statistics {
    srl-exts:delivery-node-override "true";
    leaf last-clear {
      type srl-comm:date-and-time-delta;
      description
        "Time of the last clear command performed by the user at this level or a higher level";
    }
    leaf incomplete {
      type boolean;
      description
        "Returns true when at least one linecard had insufficient stats resources to ensure an accurate set of values for the number of matched packets, or when one or more forwarding complexes have not yet contributed their counts after control plane switchover.";
    }
    leaf matched-packets {
      srl-exts:show-importance "high";
      description
        "The number of packets matching the entry since it was programmed or since the last clear, considering the mgmt0 subinterface and all subinterfaces of all linecard ports that use the ACL as an input ACL";
      type srl-comm:zero-based-counter64;
    }
    leaf matched-octets {
      srl-exts:show-importance "high";
      if-feature "srl-feat:fpcx";
      description
        "The number of octets packets matching the entry since it was programmed or since the last clear, considering the mgmt0 subinterface and all subinterfaces of all linecard ports that use the ACL as an input ACL";
      type srl-comm:zero-based-counter64;
    }
    leaf last-match {
      srl-exts:show-importance "high";
      description
        "The elapsed time since a packet last matched the entry, considering the mgmt0 subinterface and all subinterfaces of all linecard ports that use the ACL as an input ACL";
      type srl-comm:date-and-time-delta;
    }
  }

  grouping acl-subinterface-entry-statistics {
    container statistics {
      config false;
      action clear {
        srl-exts:telemetry-capability "unsupported";
        if-feature "srl-feat:tools-as-modeled-actions-same-io";
        description
          "Execute the clear action

           Reset all statistics of all entries of the filter to zero";
      }
      description
        "Enter the statistics context";
    }
    list entry {
      config false;
      key "sequence-id";
      description
        "ACL Filter statistics per entry and per subinterface";
      leaf sequence-id {
        type leafref {
          path "/acl/acl-filter[name=current()/../../name]"
             + "[type=current()/../../type]/"
             + "entry/sequence-id";
        }
        description
          "Reference to type entry ID key";
      }
      container statistics {
        if-feature "srl-feat:acl-subinterface-entry-statistics";
        description
          "Enter the statistics context

           Container for per-entry statistics";
        config false;
        uses acl-subinterface-entry-match-statistics;
        action clear {
          srl-exts:telemetry-capability "unsupported";
          if-feature "srl-feat:tools-as-modeled-actions-same-io";
          description
            "Execute the clear action

             Reset all aggregate and per-interface statistics associated with this particular entry to zero";
        }
      }
      container policer {
        if-feature "srl-feat:subif-acl-policer";
        description
          "Enter the policer context

           Policer stats for traffic matching the entry:

           Statistics under /acl/interfaces for policer configured with scope=subinterface and entry-specific=true, and acl configured with subinterface-specific=input-and-output.";
        uses acl-policer-statistics;
      }
    }
  }

  grouping acl-subinterface-policer-statistics {
    container policer {
      srl-exts:delivery-node-override "true";
      if-feature "srl-feat:subif-acl-policer";
      description
        "Enter the policer context

         Policer stats for traffic matching one or multiple entries:

         List of ACL policer statistics of scope=subinterface and per-entry-statistics=false, and acl configured with subinterface-specific=false.";
      uses acl-policer-statistics;
    }
  }

  grouping acl-filter-entry-top {
    list entry {
      key "sequence-id";
      description
        "List of ACL entries comprising an ACL Filter";
      leaf sequence-id {
        type uint32 {
          range "0..65535";
        }
        description
          "A number to indicate the relative evaluation order of the different entries; lower numbered entries are evaluated before higher numbered entries";
      }
      leaf description {
        type srl-comm:description-4k-chars;
        description
          "Description string for the filter entry";
      }
      leaf last-clear {
        config false;
        type srl-comm:date-and-time-delta;
        description
          "Time of the last clear command performed by the user at this level";
      }
      container match {
        description
          "Enter the match context

           Container for the conditions that determine whether a packet matches this entry";
        container l2 {
          if-feature "srl-feat:acl-filter-mac";
          description
            "Enter the l2 context

             Container for the common layer-2 match criteria";
          uses common-acl-filter-entry-match-l2-config;
        }
        container ipv4 {
          description
            "Enter the ipv4 context

             Container for the common layer-3 IPv4 match criteria";
          uses common-acl-filter-entry-match-ipv4-config;
        }
        container ipv6 {
          description
            "Enter the ipv6 context

             Container for the common layer-3 IPv6 match criteria";
          uses common-acl-filter-entry-match-ipv6-config;
        }
        container transport {
          description
            "Enter the transport context

             Container for the common layer-4 transport match criteria";
          uses common-acl-filter-entry-match-layer4-config;
        }
        container control-traffic {
          if-feature "srl-feat:acl-filter-control-traffic";
          description
            "Enter the control-traffic context

             Container for the mixed layer-2/layer-3 match criteria of a control-traffic filter";
          uses common-acl-filter-entry-match-control-traffic-config;
        }
        uses match-network-instance;
      }
      uses common-filter-entry-action-config;
      uses acl-filter-entry-statistics;
      uses interface-filter-entry-tcam;
    }
  }

  grouping acl-interfaces-top {
    list interface {
      key "interface-id";
      max-elements 16383;
      description
        "List of interfaces and subinterfaces referencing ACL filters.";
      leaf interface-id {
        type srl-comm:name;
        description
          "Identifier for the interface or subinterface.";
      }
      container interface-ref {
        description
          "Enter the interface-ref context

           Reference to an interface or subinterface";
        leaf interface {
          type leafref {
            path "/srl-ifs:interface/srl-ifs:name";
          }
          description
            "Reference to a base interface, for example a port or LAG";
        }
        leaf subinterface {
          type leafref {
            path "/srl-ifs:interface[srl-ifs:name=current()/../interface]/srl-ifs:subinterface/srl-ifs:index";
          }
          description
            "Reference to a subinterface

             This requires the base interface to be specified using the interface leaf in this container.";
          must '../interface' {
            error-message "interface must be configured when subinterface is set";
          }
          must "/srl-ifs:interface[srl-ifs:name=current()/../../interface-ref/interface]/srl-ifs:subinterface[srl-ifs:index=current()/../../interface-ref/subinterface]/srl-ifs:type = 'srl-ifs:bridged' or
                /srl-ifs:interface[srl-ifs:name=current()/../../interface-ref/interface]/srl-ifs:subinterface[srl-ifs:index=current()/../../interface-ref/subinterface]/srl-ifs:type = 'srl-ifs:routed' or
                string(/srl-ifs:interface[srl-ifs:name=current()/../../interface-ref/interface]/srl-ifs:subinterface[srl-ifs:index=current()/../../interface-ref/subinterface]/srl-ifs:type) = '' " {
            error-message "ACL allowed with subinterface type bridged or routed";
          }
          must "not(starts-with(../interface,'lo'))" {
            error-message "IP ACLs not allowed on loopback subinterface";
          }
        }
      }
      container input {
        description
          "Enter the input context

           Container for ACL filters that apply to ingress traffic on the subinterface";
        list acl-filter {
          key "name type";
          max-elements 4;
          ordered-by user;
          description
            "MAC, IPv4, IPv6 ACL filter(s) to be applied on this subinterface direction

             On 7220 and 7250 IXR platforms only a single MAC, IPv4 or IPv6 filter is supported.";
          leaf name {
            type leafref {
              path "/acl/acl-filter/name";
            }
            must "not (. = 'system' or . = 'capture')" {
              error-message "The acl-filter name must not be system or capture";
            }
            must "not(/acl/acl-filter[name=current()][type=current()/../type]/owner = 'subscriber-management')" {
              srl-exts:if-feature "srl-feat:submgmt-fpcx";
              error-message "ACL filters with owner subscriber-management cannot be applied here";
            }
          }
          leaf type {
            type leafref {
              path "/acl/acl-filter[name=current()/../name]"
                 + "/type";
            }
            must "not (. = 'mixed')" {
              srl-exts:if-feature "srl-feat:acl-filter-control-traffic";
              error-message "The acl-filter type must not be mixed";
            }
          }
          uses acl-subinterface-entry-statistics;
        }
        container statistics {
          srl-exts:delivery-node-override "true";
          if-feature "srl-feat:subif-acl-policer";
          description
            "Enter the statistics context

             Container for policer scope=subinterface and per-entry-statistics=false statistics";
          config false;
          leaf last-clear {
            config false;
            type srl-comm:date-and-time-delta;
            description
              "Time of the last clear command performed by the user at this level";
          }
          uses acl-subinterface-policer-statistics;
          action clear {
            srl-exts:telemetry-capability "unsupported";
            if-feature "srl-feat:tools-as-modeled-actions-same-io";
            description
              "Execute the clear action

               Reset all statistics to zero";
          }
        }
      }
      container output {
        if-feature "not srl-feat:platform-7215-a1";
        description
          "Enter the output context

           Container for ACL filters that apply to egress traffic on the subinterface";
        list acl-filter {
          key "name type";
          max-elements 4;
          ordered-by user;
          description
            "MAC, IPv4, IPv6 ACL filter(s) to be applied on this subinterface direction

             On 7220 and 7250 IXR platforms only a single MAC, IPv4 or IPv6 filter is supported.";
          leaf name {
            type leafref {
              path "/acl/acl-filter/name";
            }
            must "not (. = 'system' or . = 'capture')" {
              error-message "The acl-filter name must not be system or capture";
            }
            must "not(/acl/acl-filter[name=current()][type=current()/../type]/owner = 'subscriber-management')" {
              srl-exts:if-feature "srl-feat:submgmt-fpcx";
              error-message "ACL filters with owner subscriber-management cannot be applied here";
            }
          }
          leaf type {
            type leafref {
              path "/acl/acl-filter[name=current()/../name]"
                 + "/type";
            }
            must "not (. = 'mixed')" {
              srl-exts:if-feature "srl-feat:acl-filter-control-traffic";
              error-message "The acl-filter type must not be mixed";
            }
          }
          must "/acl/acl-filter[name=current()/name][type=current()/type]/subinterface-specific = 'output-only' or
                /acl/acl-filter[name=current()/name][type=current()/type]/subinterface-specific = 'input-and-output'" {
            srl-exts:if-feature "not srl-feat:acl-if-output-shared-tcam-entries";
            error-message "On the current platform, subinterface-specific must be set to output-only or input-and-output for egress filters.";
          }
          must "not(type = 'mac') or (/acl/acl-filter[name=current()/name][type=current()/type]/subinterface-specific = 'output-only' or
                /acl/acl-filter[name=current()/name][type=current()/type]/subinterface-specific = 'input-and-output')" {
            srl-exts:if-feature "not srl-feat:acl-if-output-shared-mac-tcam-entries";
            error-message "On the current platform, subinterface-specific must be set to output-only or input-and-output for egress MAC filters.";
          }
          uses acl-subinterface-entry-statistics;
        }
        container statistics {
          srl-exts:delivery-node-override "true";
          if-feature "srl-feat:subif-acl-policer";
          description
            "Enter the statistics context

             Container for policer scope=subinterface and per-entry-statistics=false statistics";
          config false;
          leaf last-clear {
            config false;
            type srl-comm:date-and-time-delta;
            description
              "Time of the last clear command performed by the user at this level";
          }
          uses acl-subinterface-policer-statistics;
          action clear {
            srl-exts:telemetry-capability "unsupported";
            if-feature "srl-feat:tools-as-modeled-actions-same-io";
            description
              "Execute the clear action

               Reset all statistics to zero";
          }
        }
      }
    }
  }

  grouping acl-filter-top {
    list acl-filter {
      key "name type";
      description
        "List of MAC, IPv4, IPv6 filter policies";
      leaf name {
        description
          "ACL Filter policy name";
        type srl-comm:name;
        must "not (. = 'system')" {
          srl-exts:if-feature "not srl-feat:system-filter";
          error-message "On the current platform, system filters are not supported";
        }
      }
      leaf type {
        description
          "Defines the type of ACL filter:
           ipv4: IPv4 ACL filter
           ipv6: IPv6 ACL filter
           mac: MAC ACL filter
           mixed: mixed layer-2/layer-3 filter used for QoS handling of system generated traffic";
        type enumeration {
          enum ipv4 {
            value 1;
          }
          enum ipv6 {
            value 2;
          }
          enum mac {
            if-feature "srl-feat:acl-filter-mac";
            value 3;
          }
          enum mixed {
            if-feature "srl-feat:acl-filter-control-traffic";
            value 5;
            description
              "Mixed layer-2/layer-3 filter that combines protocol, transport-port and ethernet-type match criteria and is applied to system generated traffic via the system control-plane-traffic output context";
          }
        }
        must "not (../name = 'system' or ../name = 'capture') or . = 'ipv4' or . = 'ipv6'" {
          error-message "The acl-filter name must not be system or capture";
        }
      }
      leaf owner {
        if-feature "srl-feat:submgmt-fpcx";
        type enumeration {
          enum subscriber-management {
            description
              "ACL filter for subscriber management use only";
          }
        }
        must "../type = 'ipv4' or ../type = 'ipv6'" {
          error-message "Owner subscriber-management is supported only for IPv4 and IPv6 ACL filters";
        }
        description
          "Exclusive ACL filter owner

           Only this application is permitted to use the filter.";
      }
      leaf description {
        type srl-comm:description-4k-chars;
        description
          "Description string for the filter policy";
      }
      leaf subinterface-specific {
        if-feature "not srl-feat:fpcx";
        type enumeration {
          enum disabled {
            value 1;
          }
          enum input-only {
            value 2;
          }
          enum output-only {
            value 3;
          }
          enum input-and-output {
            value 4;
          }
        }
        must "not (../name = 'system' or ../name = 'capture') or . = 'disabled'" {
          error-message "The acl-filter name must not be system or capture";
        }
        default "disabled";
        description
          "Controls the instantiation of the filter when it is applied as an input or output ACL

           disabled: all subinterfaces on a single linecard that reference the ACL as an input ACL use a shared filter instance, and all subinterfaces on a single linecard that reference the ACL as an output ACL use a shared filter instance

           input-only: all subinterfaces on a single linecard that reference the ACL as an output ACL use a shared filter instance, but each subinterface that references the ACL as an input ACL uses its own separate instance of the filter

           output-only: all subinterfaces on a single linecard that reference the ACL as an input ACL use a shared filter instance, but each subinterface that references the ACL as an output ACL uses its own separate instance of the filter

           input-and-output: each subinterface that references the ACL as either an input ACL or an output ACL uses its own separate instance of the filter";
      }
      leaf statistics-per-entry {
        if-feature "not srl-feat:fpcx";
        type boolean;
        must "not (../name = 'system' or ../name = 'capture')" {
          error-message "The acl-filter name must not be system or capture";
        }
        description
          "Collect statistics for each entry of the ACL. If this is set to false no hardware resources are allocated to collecting statistics for this ACL policy.

           The exact set of statistics depend on the subinterface-specific mode";
      }
      leaf last-clear {
        config false;
        type srl-comm:date-and-time-delta;
        description
          "Time of the last clear command performed by the user at this level";
      }
      container statistics {
        config false;
        action clear {
          srl-exts:telemetry-capability "unsupported";
          if-feature "srl-feat:tools-as-modeled-actions-same-io";
          description
            "Execute the clear action

             Reset all statistics of all entries of the filter to zero";
        }
        description
          "Enter the statistics context";
      }
      uses acl-filter-embed-top;
      uses acl-filter-entry-top;
    }
  }

  grouping acl-top {
    container acl {
      description
        "Enter the acl context

         Top level container for configuration and operational state related to access control lists (ACLs)";
      uses acl-filter-top;
      uses acl-interfaces-top;
      uses acl-policers-top;
      uses datapath-programming;
      uses match-list-top;
      leaf ipv4-tcam-action-profile {
        if-feature "srl-feat:acl-ipv4-tcam-action-profile";
        type enumeration {
          enum acl-log-reject {
            description
              "IPv4 ACL filter entries may use the log and reject actions
               BGP FlowSpec redirect actions are not programmed in hardware; BGP marks affected routes flowspec-unsupported-action";
          }
          enum bgp-flowspec-redirect {
            description
              "Hardware TCAM action encoding is repurposed so BGP FlowSpec redirect actions are programmed
               In this mode IPv4 ACL filter entries cannot use the log or reject actions. No user-configurable redirect action is added to ACLs; redirect is driven only by BGP FlowSpec";
          }
        }
        default "acl-log-reject";
        description
          "This profile selects between IPv4 ACL log and reject actions and BGP FlowSpec redirect programming in hardware";
      }
      leaf egress-mac-filtering {
        if-feature "srl-feat:egress-mac-filter-restriction";
        type boolean;
        default "false";
        description
          "Must be set to true in order to apply any MAC ACLs to any subinterface in the egress traffic direction.

           Internally this sets the following limits:
           - maximum number of IPv4 ACL instances that can be created to process egress traffic = 32
           - maximum number of IPv6 ACL instances that can be created to process egress traffic = 32
           - maximum number of MAC ACL instances that can be created to process egress traffic = 32

           Remember that the number of ACL instances per ACL policy is greater than one if subinterface-specific is set to input-and-output or output-only.

           A setting of true is blocked if the number of IPv4 ACL instances applied to egress traffic is already greater than 32, or if the number of IPv6 ACL instances applied to egress traffic is already greater than 32.";
      }
    }
  }

  grouping control-plane-binding {
    container acl {
      description
        "Enter the acl context

         Container for ACL.";
      list acl-filter {
        key "name type";
        description
          "List MAC, IPv4, IPv6 ACL filter(s) to be applied on this subinterface direction";
        leaf name {
          type leafref {
            path "/srl-acl:acl/acl-filter/name";
          }
          must "not (. = 'system' or . = 'capture')" {
            error-message "The acl-filter name must not be system or capture";
          }
          must "not(/srl-acl:acl/acl-filter[name=current()][type=current()/../type]/owner = 'subscriber-management')" {
            srl-exts:if-feature "srl-feat:submgmt-fpcx";
            error-message "ACL filters with owner subscriber-management cannot be applied here";
          }
          description
            "Referencence to the ACL Filter policy name";
        }
        leaf type {
          type leafref {
            path "/acl/acl-filter[name=current()/../name]"
               + "/type";
          }
          must "not (. = 'mac')" {
            srl-exts:if-feature "not srl-feat:acl-cpm-filter-type-mac";
            error-message "On the current platform, control plane acl-filter type mac is not supported";
          }
          must "not (. = 'mixed')" {
            srl-exts:if-feature "srl-feat:acl-filter-control-traffic";
            error-message "For control plane input acl-filter type mixed is not supported";
          }
          description
            "Referencence to the ACL Filter policy type";
        }
      }
    }
  }

  augment "/srl-sys:system/srl-sys:control-plane-traffic/srl-sys:input" {
    uses control-plane-binding;
  }

  grouping control-plane-output-binding {
    container acl {
      if-feature "srl-feat:acl-filter-control-traffic";
      description
        "Enter the acl context

         Container for the control-traffic ACL filter applied to system generated traffic in the output direction";
      list acl-filter {
        key "name type";
        description
          "List of control-traffic ACL filter(s) applied to system generated traffic in the output direction";
        leaf name {
          type leafref {
            path "/srl-acl:acl/acl-filter/name";
          }
          description
            "Reference to the control-traffic ACL filter policy name";
        }
        leaf type {
          type leafref {
            path "/acl/acl-filter[name=current()/../name]"
               + "/type";
          }
          must ". = 'mixed'" {
            error-message "Only acl-filter of type mixed can be applied to the system control-plane-traffic output";
          }
          description
            "Reference to the mixed ACL filter policy type";
        }
      }
    }
  }

  augment "/srl-sys:system/srl-sys:control-plane-traffic/srl-sys:output" {
    uses control-plane-output-binding;
  }

  uses acl-top;
}
