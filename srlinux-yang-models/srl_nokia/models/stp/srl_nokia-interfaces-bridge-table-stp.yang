module srl_nokia-interfaces-bridge-table-stp {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:stp:interfaces-bridge-table-stp";
  prefix srl-ifs-brid-tbl-stp;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-interfaces {
    prefix srl-ifs;
  }
  import srl_nokia-stp-types {
    prefix srl-stp-type;
  }
  import srl_nokia-stp-common {
    prefix srl-stp-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-interfaces-l2cp {
    prefix srl-ifs-l2cp;
  }
  import srl_nokia-interfaces-vlans {
    prefix srl-ifs-vlan;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This yang file provides Stp configuration under interface's bridge table.

     Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-10-31 {
    description
      "SR Linux 25.10.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }

  grouping interface-stp-counters {
    container statistics {
      config false;
      description
        "Enter the statistics context

         Packet transmition statistics";
      leaf bad-bpdus-received {
        type srl-comm:zero-based-counter64;
        description
          "The number of Invalid BPDUs received";
      }
      leaf cfg-bpdus-received {
        type srl-comm:zero-based-counter64;
        description
          "The number of configuration BPDUs received on this interface";
      }
      leaf cfg-bpdus-transmitted {
        type srl-comm:zero-based-counter64;
        description
          "The number of configuration BPDUs sent on this interface";
      }
      leaf tcn-bpdus-received {
        type srl-comm:zero-based-counter64;
        description
          "The number of topology change notification BPDUs received on this interface";
      }
      leaf tcn-bpdus-transmitted {
        type srl-comm:zero-based-counter64;
        description
          "The number of topology change notification BPDUs sent on this interface";
      }
      leaf tc-bit-bpdus-received {
        type srl-comm:zero-based-counter64;
        description
          "The number of BPDUs received on this interface with the Topology Change bit set";
      }
      leaf tc-bit-bpdus-transmitted {
        type srl-comm:zero-based-counter64;
        description
          "The number of BPDUs sent on this interface with the Topology Change bit set";
      }
      leaf rst-bpdus-received {
        type srl-comm:zero-based-counter64;
        description
          "The number of RST BPDUs received on this interface";
      }
      leaf rst-bpdus-transmitted {
        type srl-comm:zero-based-counter64;
        description
          "The number of RST BPDUs sent on this interface";
      }
      leaf mst-bpdus-received {
        type srl-comm:zero-based-counter64;
        description
          "The number of MST BPDUs received on this interface";
      }
      leaf mst-bpdus-transmitted {
        type srl-comm:zero-based-counter64;
        description
          "The number of MST BPDUs sent on this interface";
      }
    }
  }

  grouping managed-interface-stp-state {
    uses srl-stp-comm:stp-port-state;
    uses srl-stp-comm:oper-mgmt-stp-name;
    uses srl-stp-comm:oper-mgmt-stp-interface;
    uses srl-stp-comm:oper-mgmt-stp-msti;
    uses srl-stp-comm:stp-forward-transitions;
  }

  grouping interface-stp-state {
    uses srl-stp-comm:stp-port-state;
    uses srl-stp-comm:stp-port-num;
    uses srl-stp-comm:stp-port-priority;
    uses srl-stp-comm:stp-port-role;
    uses srl-stp-comm:stp-oper-state;
    uses srl-stp-comm:stp-designated-bridge;
    uses srl-stp-comm:stp-designated-port;
    uses srl-stp-comm:stp-designated-port-priority;
    uses srl-stp-comm:stp-designated-port-num;
    uses srl-stp-comm:stp-oper-protocol;
    uses srl-stp-comm:stp-oper-bpdu-encap;
    uses srl-stp-comm:stp-oper-edge;
    uses srl-stp-comm:stp-forward-transitions;
  }

  grouping interface-stp-bpdu-guard-state {
    uses srl-stp-comm:stp-bpdu-guard-error;
    uses srl-stp-comm:stp-bpdu-guard-recovery-time-expires;
  }

  grouping interface-stp-config {
    description
      "Interface common STP configuration";
    leaf port-number {
      type srl-stp-type:port-num-type;
      description
        "Port Number associated with this interface";
    }
    leaf priority {
      type srl-stp-type:port-priority-type;
      default "128";
      description
        "Priority value coupled with port number forms 16-bit port-identifier field";
    }
    leaf path-cost {
      type srl-stp-type:path-cost-type;
      default "10";
      description
        "The interface path-cost is used by STP to calculate the path cost to the root bridge";
    }
    uses srl-stp-type:stp-edge-port;
    leaf link-type {
      type srl-stp-type:link-type-type;
      default "P2P";
      description
        "Indicates the number of bridges behind the subinterface";
    }
    leaf guard {
      type srl-stp-type:guard-type;
      default "NONE";
      description
        "Enable Guard";
    }
    uses srl-stp-comm:stp-bpdu-config;
  }

  grouping interface-bridge-table-stp-top {
    description
      "Top level grouping for STP configuration under interface's bridge table";
    container stp {
      description
        "Configuration and state of the STP protocol";
      presence "Configure Interface STP";
      must 'not(/srl-ifs:interface[srl-ifs:name=current()/../../../srl-ifs:name]/srl-ifs:ethernet/srl-ifs:l2cp-transparency/srl-ifs-l2cp:tunnel-all-l2cp)' {
        error-message "STP and tunnel-all-l2cp cannot be enabled on the same interface";
      }
      must 'not(/srl-ifs:interface[srl-ifs:name=current()/../../../srl-ifs:name]/srl-ifs:ethernet/srl-ifs:l2cp-transparency/srl-ifs-l2cp:xstp/srl-ifs-l2cp:tunnel)' {
        error-message "STP and xSTP tunnel cannot be enabled on the same interface";
      }
      must 'not(../../srl-ifs-vlan:vlan/srl-ifs-vlan:encap/srl-ifs-vlan:single-tagged-range)' {
        error-message "STP cannot be enabled on sub-interface with encap vlan-range enabled";
      }
      must "not (starts-with(/srl-ifs:interface[srl-ifs:name=current()/../../../srl-ifs:name]/srl-ifs:name,'irb'))" {
        error-message "STP cannot be enabled on IRB sub-interface";
      }
      leaf admin-state {
        type srl-comm:admin-state;
        default "disable";
        description
          "Administratively enable or disable the STP protocol for interface

           When STP on the network instance is administratively disabled,
           any BPDUs are forwarded transparently.
           When STP on the network instance is administratively enabled,
           but the administrative state on a sub-interface is disabled,
           BPDUs received on such a subinterface are discarded.";
      }
      uses interface-stp-config;
      uses interface-stp-state;
      uses interface-stp-bpdu-guard-state;
      uses interface-stp-counters;
    }
  }

  grouping interface-bridge-table-managed-stp-top {
    description
      "Top level grouping for state info of mgmt-stp managed interface";
    container managed-stp {
      uses managed-interface-stp-state;
      description
        "Enter the managed-stp context";
    }
  }

  augment "/srl-ifs:interface/srl-ifs:subinterface/srl-ifs:bridge-table" {
    uses interface-bridge-table-stp-top {
      if-feature "srl-feat:stp";
    }
    uses interface-bridge-table-managed-stp-top {
      if-feature "srl-feat:stp";
    }
  }
}
