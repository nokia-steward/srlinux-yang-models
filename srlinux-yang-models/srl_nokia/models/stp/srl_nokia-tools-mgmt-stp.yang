module srl_nokia-tools-mgmt-stp {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:stp:tools-mgmt-stp";
  prefix srl-tool-mgmt-stp;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-tools-system {
    prefix srl-tool-sys;
  }
  import srl_nokia-tools-system-network-instance-protocols {
    prefix srl-tool-sys-netinst-prot;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for Mgmt-Stp operational commands

     Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }

  grouping mgmt-stp-tools-top {
    list mgmt-stp {
      key "name";
      description
        "Management Stp Instance on the system";
      leaf name {
        type srl-comm:restricted-name;
        description
          "mgmt-stp instance name";
      }
      container statistics {
        leaf clear {
          type empty;
          description
            "Clear all Stp statistics of this Mgmt-Stp Instance";
        }
        description
          "Enter the statistics context";
      }
      container bpdu-guard-error {
        leaf clear {
          type empty;
          description
            "Clear bpdu guard error on Mgmt-Stp";
        }
        description
          "Enter the bpdu-guard-error context";
      }
      list interface {
        key "interface-name";
        description
          "List of Interfaces managed by Mgmt-Stp";
        leaf interface-name {
          type string;
          description
            "Mgmt-Stp interface name";
        }
        container statistics {
          leaf clear {
            type empty;
            description
              "Clear all Stp statistics on this Mgmt-Stp Interface";
          }
          description
            "Enter the statistics context";
        }
        container bpdu-guard-error {
          leaf clear {
            type empty;
            description
              "Clear bpdu guard error on Mgmt-Stp interface";
          }
          description
            "Enter the bpdu-guard-error context";
        }
      }
    }
  }

  augment "/srl-tool-sys:system/srl-tool-sys-netinst-prot:network-instance/srl-tool-sys-netinst-prot:protocols" {
    uses mgmt-stp-tools-top {
      if-feature "srl-feat:stp";
    }
  }
}
