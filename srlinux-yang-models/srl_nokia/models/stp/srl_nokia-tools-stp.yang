module srl_nokia-tools-stp {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:stp:tools-stp";
  prefix srl-tool-stp;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-tools-network-instance {
    prefix srl-tool-netinst;
  }
  import srl_nokia-tools-interfaces {
    prefix srl-tool-ifs;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for STP operational commands

     Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }

  grouping stp-tools-top {
    container stp {
      presence "Send operational commands to STP manager";
      container statistics {
        leaf clear {
          type empty;
          description
            "Clear all Stp statistics";
        }
        description
          "Enter the statistics context";
      }
      container bpdu-guard-error {
        leaf clear {
          type empty;
          description
            "Clear Bpdu Guard Error";
        }
        description
          "Enter the bpdu-guard-error context";
      }
    }
  }

  augment "/srl-tool-netinst:network-instance/srl-tool-netinst:protocols" {
    uses stp-tools-top {
      if-feature "srl-feat:stp";
    }
  }

  augment "/srl-tool-ifs:interface/srl-tool-ifs:subinterface/srl-tool-ifs:bridge-table" {
    uses stp-tools-top {
      if-feature "srl-feat:stp";
    }
  }
}
