module srl_nokia-tunnel-interfaces-vxlan-interface-bridge-table-unicast-es-destination-vteps {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:vxlan:tunnel-interfaces-vxlan-interface-bridge-table-unicast-es-destination-vteps";
  prefix srl-tunn-ifs-vxla-if-brid-tbl-unic-es-dst-vtep;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-tunnel-interfaces {
    prefix srl-tunn-ifs;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-tunnel-interfaces-vxlan-interface-bridge-table-unicast-destinations {
    prefix srl-tunn-ifs-vxla-if-brid-tbl-unic-dest;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for bridge-table unicast destinations on the vxlan-interface

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }

  grouping bridge-table-vxlan-interface-unicast-destinations-es-destination-vteps-top {
    list vtep {
      config false;
      key "address vni";
      leaf address {
        srl-exts:show-importance "high";
        type srl-comm:ip-address;
        description
          "The IP address that identifies the remote VXLAN Termination Endpoint (VTEP).";
      }
      leaf vni {
        type uint32 {
          range "1..16777215";
        }
        srl-exts:show-importance "high";
        description
          "VXLAN Network Identifier of the destination.";
      }
    }
  }

  augment "/srl-tunn-ifs:tunnel-interface/srl-tunn-ifs:vxlan-interface/srl-tunn-ifs:bridge-table/srl-tunn-ifs-vxla-if-brid-tbl-unic-dest:unicast-destinations/srl-tunn-ifs-vxla-if-brid-tbl-unic-dest:es-destination" {
    uses bridge-table-vxlan-interface-unicast-destinations-es-destination-vteps-top;
  }
}
