module srl_nokia-tools-tunnel {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:vxlan:tools-tunnel";
  prefix srl-tool-tunn;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }

  grouping tools-tunnel-top {
    container tunnel {
      description
        "Enter the tunnel context

         Top-level container for the tunnel table.";
      if-feature "srl-feat:vxlan or srl-feat:pseudowire";
      srl-exts:first-released "20.10.1";
    }
  }

  uses tools-tunnel-top;
}
