module srl_nokia-oam-pm-ethcfm {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:ethcfm:oam-pm-ethcfm";
  prefix srl-oam-pm-ethc;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-oam {
    prefix srl-oam;
  }
  import srl_nokia-oam-pm {
    prefix srl-oam-pm;
  }
  import srl_nokia-oam-pm-types {
    prefix srl-oam-pm-type;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-ethcfm {
    prefix srl-ethc;
  }
  import srl_nokia-ethcfm-types {
    prefix srl-ethc-type;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-qos {
    prefix srl-qos;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This YANG module contains the management data definitions for the
     Ethernet CFM Performance Monitoring.

     Copyright 2023-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-10-31 {
    description
      "SR Linux 25.10.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }
  revision 2023-10-31 {
    description
      "SR Linux 23.10.1";
  }

  augment "/srl-oam:oam/srl-oam:performance-monitoring" {
    if-feature "srl-feat:oam-pm and srl-feat:oam-pm-ethcfm";
    container ethcfm {
      presence "OAM Performance Monitoring using Ethernet CFM";
      uses srl-oam-pm:oam-pm-resources;
      container delay {
        if-feature "srl-feat:oam-pm-ethcfm-dmm";
        uses srl-oam-pm:bin-group;
        description
          "Enter the delay context";
      }
      container loss {
        if-feature "srl-feat:oam-pm-ethcfm-slm";
        uses srl-oam-pm:loss-events;
        description
          "Enter the loss context";
      }
      list session {
        key "session-name";
        description
          "Enter the session list instance which contains the test session configuration";
        uses srl-oam-pm:session;
        uses srl-oam-pm:measurement-interval;
        container source {
          leaf domain-id {
            mandatory true;
            type leafref {
              path "/srl-oam:oam/srl-ethc:ethcfm/srl-ethc:domain/srl-ethc:domain-id";
            }
            description
              "The maintenance domain identifier";
          }
          leaf association-id {
            mandatory true;
            type leafref {
              path "/srl-oam:oam/srl-ethc:ethcfm/srl-ethc:domain[srl-ethc:domain-id=current()/../domain-id]/srl-ethc:association/srl-ethc:association-id";
            }
            description
              "The maintenance association identifier specific to the domain identifier";
          }
          leaf mep-id {
            mandatory true;
            type leafref {
              path "/srl-oam:oam/srl-ethc:ethcfm/srl-ethc:domain[srl-ethc:domain-id=current()/../domain-id]/srl-ethc:association[srl-ethc:association-id=current()/../association-id]/srl-ethc:mep/srl-ethc:mep-id";
            }
            description
              "The MEP identifier specific to the domain and association identifier";
          }
          description
            "Enter the source context";
        }
        leaf target {
          mandatory true;
          type union {
            type srl-comm:unicast-mac-address;
            type srl-ethc-type:mep-id-type;
          }
          description
            "Target MAC address or remote MEP ID for the test";
        }
        leaf priority {
          type srl-ethc-type:priority-type;
          default "7";
          description
            "The priority used when generating CFM test frames";
        }
        leaf forwarding-class {
          if-feature "srl-feat:qos";
          type leafref {
            path "/srl-qos:qos/srl-qos:forwarding-classes/srl-qos:forwarding-class/srl-qos:name";
          }
          description
            "The forwarding class

             When value not specified, the sgt-qos value will be used";
        }
        leaf profile {
          if-feature "srl-feat:qos";
          type srl-comm:rewrite-profile;
          description
            "The profile or drop precedence

             When value not specified, the sgt-qos value will be used";
        }
        container eth-cfm-single-ended-dmm-test {
          if-feature "srl-feat:oam-pm-ethcfm-dmm";
          leaf admin-state {
            type srl-comm:admin-state;
            srl-exts:show-importance "high";
            default "disable";
            description
              "Administrative state of the single ended test";
          }
          uses srl-oam-pm:operational-states-errors;
          uses srl-oam-pm:test-session;
          leaf interval {
            type srl-oam-pm-type:oam-pm-interval-cfm-dmm;
            default "1s";
            description
              "The transmission rate of the CFM packets";
          }
          leaf bin-group {
            srl-exts:show-importance "high";
            type leafref {
              path "../../../delay/bin-group/bin-group-name";
            }
            default "default";
            description
              "Reference the bin group to be used for this session

               If not specified the 'default' bin-group will be used";
          }
          uses srl-oam-pm:bin-group-state;
          list measurement-result {
            config false;
            description
              "The test statistics for a delay measurement";
            key "mi-ro-type";
            leaf mi-ro-type {
              type srl-oam-pm-type:measurement-interval-ro-duration-type;
              description
                "The duration of the measurement interval";
            }
            uses srl-oam-pm:measurement-interval-index-tracking;
            list index {
              key "index";
              leaf index {
                type uint32;
                description
                  "Measurement interval unique identifier";
              }
              uses srl-oam-pm:mi-common-state;
              container statistics {
                leaf nominal-frame-count {
                  type union {
                    type srl-comm:zero-based-counter32;
                    type enumeration {
                      enum not-applicable;
                    }
                  }
                  description
                    "Number of test frames that comprise a completed measurement interval
                     The value of this field is equal to the full length of the measurement-interval duration multiplied by the interval.
                     This value is 'not-applicable to the 'raw' measurement-interval, as it is unbounded.";
                }
                uses srl-oam-pm:mi-delay-statistics;
                description
                  "Enter the statistics context";
              }
            }
          }
          uses srl-oam-pm:delay-events-state;
          description
            "Enter the eth-cfm-single-ended-dmm-test context";
        }
        container eth-cfm-single-ended-slm-test {
          if-feature "srl-feat:oam-pm-ethcfm-slm";
          leaf admin-state {
            type srl-comm:admin-state;
            default "disable";
            description
              "Administrative state of the single ended test";
          }
          uses srl-oam-pm:operational-states-errors;
          uses srl-oam-pm:test-session;
          leaf data-tlv-size {
            type srl-oam-pm-type:data-tlv-size;
            default "0";
            description
              "The Data TLV byte count used to increase the size of the base CFM PDU
               A value '0' means no Data TLV is added.  Any other value represents the size of the Data TLV.";
          }
          leaf interval {
            description
              "The transmission rate of the CFM packets";
            type srl-oam-pm-type:oam-pm-interval-cfm-slm;
            default "1s";
          }
          uses srl-oam-pm:frame-loss-configuration;
          leaf loss-event {
            type leafref {
              path "../../../loss/loss-events-template/loss-events-template-name";
            }
            description
              "The loss event template associated with this loss test session and measurement interval";
          }
          list measurement-result {
            config false;
            description
              "The test statistics for a delay measurement.";
            key "mi-ro-type";
            leaf mi-ro-type {
              type srl-oam-pm-type:measurement-interval-ro-duration-type;
              description
                "The duration of the measurement interval";
            }
            uses srl-oam-pm:measurement-interval-index-tracking;
            list index {
              key "index";
              leaf index {
                description
                  "Measurement interval unique identifier";
                type uint32;
              }
              uses srl-oam-pm:mi-common-state;
              container statistics {
                uses srl-oam-pm:mi-general-loss-statistics;
                container forward {
                  uses srl-oam-pm:mi-forward-loss;
                  uses srl-oam-pm:mi-directional-loss-statistics;
                  description
                    "Enter the forward context";
                }
                container backward {
                  uses srl-oam-pm:mi-backward-loss;
                  uses srl-oam-pm:mi-directional-loss-statistics;
                  description
                    "Enter the backward context";
                }
                description
                  "Enter the statistics context";
              }
            }
          }
          uses srl-oam-pm:loss-events-state;
          description
            "Enter the eth-cfm-single-ended-slm-test context";
        }
        action start {
          srl-exts:telemetry-capability "unsupported";
          if-feature "srl-feat:tools-as-modeled-actions-different-io-ethcfm-mgr";
          description
            "Execute the start action

             Start an OAM-PM on-demand session";
        }
        action stop {
          srl-exts:telemetry-capability "unsupported";
          if-feature "srl-feat:tools-as-modeled-actions-different-io-ethcfm-mgr";
          description
            "Execute the stop action

             Stop an OAM-PM on-demand session";
        }
        action clear {
          srl-exts:telemetry-capability "unsupported";
          if-feature "srl-feat:tools-as-modeled-actions-same-io";
          description
            "Execute the clear action

             Clear all raw bin statistics";
        }
      }
    }
  }
}
