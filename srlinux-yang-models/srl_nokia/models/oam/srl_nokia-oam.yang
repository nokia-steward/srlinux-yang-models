module srl_nokia-oam {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:oam:oam";
  prefix srl-oam;

  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines configuration and operational state data
     related to OAM (Operations, Administration and Maintenance)
     functionality.

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }
  revision 2023-07-31 {
    description
      "SR Linux 23.7.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }

  container oam {
    if-feature "srl-feat:oam";
    description
      "Enter the oam context

       Enclosing container for OAM";
    container performance-monitoring {
      presence "OAM Performance monitoring";
      if-feature "srl-feat:oam-pm";
      description
        "OAM Performance Monitoring";
    }
  }
}
