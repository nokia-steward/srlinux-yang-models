module srl_nokia-tools-oam {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:oam:tools-oam";
  prefix srl-tool-oam;

  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for operational commands on OAM.

     Copyright 2024-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }

  container oam {
    presence "Configure tools OAM";
    description
      "Enclosing container for OAM management.";
    container performance-monitoring {
      if-feature "srl-feat:oam-pm";
      presence "Configure tools OAM-PM";
      description
        "OAM Performance Monitoring";
    }
  }
}
