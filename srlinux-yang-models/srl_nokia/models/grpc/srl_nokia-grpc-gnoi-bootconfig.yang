module srl_nokia-grpc-gnoi-bootconfig {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:grpc:grpc-gnoi-bootconfig";
  prefix srl-grpc-gnoi-boot;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for the gNOI BootConfig actions exposed under system configuration.

     Copyright 2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }

  grouping gnoi-bootconfig-top {
    description
      "gNOI BootConfig actions container, used under system configuration.";
    container bootconfig {
      config false;
      description
        "Enter the bootconfig context

         gNOI BootConfig actions";
      action remove {
        srl-exts:telemetry-capability "unsupported";
        if-feature "srl-feat:tools-as-modeled-actions-same-io";
        description
          "Execute the remove action

           Remove all BootConfig data from the system";
      }
      action set {
        srl-exts:telemetry-capability "unsupported";
        if-feature "srl-feat:tools-as-modeled-actions-same-io";
        description
          "Execute the set action

           Set BootConfig data";
        input {
          container boot-config {
            leaf vendor-config {
              type string;
              description
                "The vendor specific boot configuration data";
            }
            leaf oc-config {
              type string;
              description
                "The openconfig specific boot configuration data";
            }
            leaf dynamic-vendor-config {
              type string;
              description
                "The dynamic vendor specific boot configuration data";
            }
            leaf dynamic-oc-config {
              type string;
              description
                "The dynamic openconfig specific boot configuration data";
            }
          }
        }
      }
      action get {
        srl-exts:telemetry-capability "unsupported";
        if-feature "srl-feat:tools-as-modeled-actions-different-io-common";
        description
          "Execute the get action

           Get BootConfig data";
        input {
          container boot-config {
            leaf vendor-config {
              type empty;
              description
                "The vendor specific boot configuration data";
            }
            leaf oc-config {
              type empty;
              description
                "The openconfig specific boot configuration data";
            }
            leaf dynamic-vendor-config {
              type empty;
              description
                "The dynamic vendor specific boot configuration data";
            }
            leaf dynamic-oc-config {
              type empty;
              description
                "The dynamic openconfig specific boot configuration data";
            }
          }
        }
        output {
          container boot-config {
            leaf vendor-config {
              type string;
              description
                "The vendor specific boot configuration data";
            }
            leaf oc-config {
              type string;
              description
                "The openconfig specific boot configuration data";
            }
            leaf dynamic-vendor-config {
              type string;
              description
                "The dynamic vendor specific boot configuration data";
            }
            leaf dynamic-oc-config {
              type string;
              description
                "The dynamic openconfig specific boot configuration data";
            }
          }
        }
      }
    }
  }
}
