module srl_nokia-network-instance-leaking {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:net-inst:network-instance-leaking";
  prefix srl-netinst-leak;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-network-instance {
    prefix srl-netinst;
  }
  import srl_nokia-routing-policy {
    prefix srl-rpol;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "YANG model for inter-network-instance route leaking

     Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2026-03-31 {
    description
      "SR Linux 26.3.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }

  grouping inter-instance-policies-top {
    container inter-instance-policies {
      description
        "Enter the inter-instance-policies context

         Policies for leaking routes between this network instance and other network instances";
      container apply-policy {
        description
          "Enter the apply-policy context

           Container for specifying route leaking import and export policies";
        leaf-list import-policy {
          ordered-by user;
          max-elements 1;
          description
            "Chained sequence of policies used to specify the routes leaked by other NIs that should be imported into this NI";
          type leafref {
            path "/srl-rpol:routing-policy/srl-rpol:policy/srl-rpol:name";
          }
          must "../../../srl-netinst:type = 'ip-vrf' or ../../../srl-netinst:type = 'default'" {
            error-message "Route leaking is only suported in the default and ip-vrf network-instances";
          }
        }
        leaf-list export-policy {
          ordered-by user;
          max-elements 1;
          description
            "Chained sequence of policies used to specify the routes of this NI that should be made available for leaking to other NIs";
          type leafref {
            path "/srl-rpol:routing-policy/srl-rpol:policy/srl-rpol:name";
          }
          must "../../../srl-netinst:type = 'ip-vrf' or ../../../srl-netinst:type = 'default'" {
            error-message "Route leaking is only suported in the default and ip-vrf network-instances";
          }
        }
      }
    }
  }

  augment "/srl-netinst:network-instance" {
    if-feature "srl-feat:route-leaking";
    uses inter-instance-policies-top;
  }
}
