module srl_nokia-tools-group-based-policy {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:group-based-policy:tools-gbp";
  prefix srl-tool-grou-base-poli;

  import srl_nokia-tools-network-instance {
    prefix srl-tool-netinst;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "A model tools for Group Based Policy of a network instance

     Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-10-31 {
    description
      "SR Linux 25.10.1";
  }

  grouping gbp-tools-top {
    container group-based-policy {
      description
        "Enter the group-based-policy context";
    }
  }

  augment "/srl-tool-netinst:network-instance" {
    uses gbp-tools-top;
    if-feature "srl-feat:group-based-policy";
  }
}
