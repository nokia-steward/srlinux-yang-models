module srl_nokia-tools-route-table {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:general:tools-route-table";
  prefix srl-tool-rout-tbl;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-tools-network-instance {
    prefix srl-tool-netinst;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "YANG model for IP route operational commands

     Copyright 2024-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }

  grouping route-tools-top {
    container route-table {
      presence "Top-level container for operational commands related to route tables";
      container ipv4-unicast {
        description
          "Enter the ipv4-unicast context

           The container for the IPv4 unicast routing table of the network instance.";
        container longest-prefix-match {
          leaf ipv4-address {
            type srl-comm:ipv4-address;
            description
              "The IPv4 address for which the longest prefix match route should be returned";
          }
          description
            "Enter the longest-prefix-match context";
        }
      }
      container ipv6-unicast {
        description
          "Enter the ipv6-unicast context

           The container for the IPv6 unicast routing table of the network instance.";
        container longest-prefix-match {
          leaf ipv6-address {
            type srl-comm:ipv6-address;
            description
              "The IPv6 address for which the longest prefix match route should be returned";
          }
          description
            "Enter the longest-prefix-match context";
        }
      }
    }
  }

  augment "/srl-tool-netinst:network-instance" {
    if-feature "srl-feat:longest-prefix-match";
    uses route-tools-top;
  }
}
