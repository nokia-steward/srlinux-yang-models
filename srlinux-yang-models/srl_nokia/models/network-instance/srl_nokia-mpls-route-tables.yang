module srl_nokia-mpls-route-tables {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:fib:mpls-route-tables";
  prefix srl-mpls-rout-tbls;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-network-instance {
    prefix srl-netinst;
  }
  import srl_nokia-ip-route-tables {
    prefix srl-ip-rout-tbls;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-bgp-vpn {
    prefix srl-bgp-vpn;
  }
  import srl_nokia-system {
    prefix srl-sys;
  }
  import srl_nokia-system-network-instance {
    prefix srl-sys-netinst;
  }
  import srl_nokia-system-network-instance-bgp-evpn-ethernet-segments {
    prefix srl-sys-netinst-bgp-evpn-ethe-segm;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "A model describing the MPLS routing tables of a network instance.

     Copyright 2019-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2026-03-31 {
    description
      "SR Linux 26.3.1";
  }
  revision 2025-10-31 {
    description
      "SR Linux 25.10.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }
  revision 2023-07-31 {
    description
      "SR Linux 23.7.1";
  }
  revision 2021-06-30 {
    description
      "SR Linux 21.6.1";
  }
  revision 2019-11-30 {
    description
      "SR Linux 19.11.1";
  }

  typedef label-operation-type {
    description
      "MPLS label forwarding operation type";
    type enumeration {
      enum pop;
      enum swap;
      enum swap-pop;
      enum pop-xconnect-unicast;
      enum pop-xconnect-multicast;
    }
  }

  grouping table-summary {
    container table-summary {
      description
        "Enter the table-summary context

         Label FIB summary information";
      list label-type {
        key "entry-type operation";
        leaf entry-type {
          type identityref {
            base srl-comm:mpls-label-entry-type;
          }
          description
            "Label owner or protocol";
        }
        leaf operation {
          type srl-mpls-rout-tbls:label-operation-type;
          description
            "Label operation";
        }
        leaf total-entries {
          type srl-comm:zero-based-counter64;
          description
            "Total number of ILMs associated with this owner and operation type";
        }
      }
    }
  }

  grouping mpls-entry-common-fields {
    leaf operation {
      type srl-mpls-rout-tbls:label-operation-type;
      srl-exts:show-importance "high";
      description
        "The forwarding operation associated with the MPLS label entry.";
    }
    leaf entry-type {
      type identityref {
        base srl-comm:mpls-label-entry-type;
      }
      srl-exts:show-importance "high";
      description
        "The entry type of the MPLS FIB entry.";
    }
    leaf last-app-update {
      type srl-comm:date-and-time-delta;
      description
        "The date and time of the last update of this MPLS label entry by the owning application or protocol.";
    }
    leaf next-hop-group {
      type leafref {
        path "/srl-netinst:network-instance/srl-netinst:route-table/srl-ip-rout-tbls:next-hop-group/srl-ip-rout-tbls:index";
      }
      description
        "The next-hop-group indirection object used by this route. Applicable only if the operation is SWAP.";
    }
    leaf next-network-instance {
      type leafref {
        path "/srl-netinst:network-instance/srl-netinst:name";
      }
      description
        "Packets matching the ILM entry are forwarded in the referenced network-instance";
    }
    leaf next-bgp-instance {
      if-feature "srl-feat:evpn or srl-feat:ipvpn";
      type leafref {
        path "/srl-netinst:network-instance/srl-netinst:protocols/srl-bgp-vpn:bgp-vpn/srl-bgp-vpn:bgp-instance/srl-bgp-vpn:id";
      }
    }
    leaf next-ethernet-segment {
      if-feature "srl-feat:evpn-mh";
      type leafref {
        path "/srl-sys:system/srl-sys-netinst:network-instance/srl-sys-netinst:protocols/srl-sys-netinst:evpn/srl-sys-netinst-bgp-evpn-ethe-segm:ethernet-segments/srl-sys-netinst-bgp-evpn-ethe-segm:bgp-instance/srl-sys-netinst-bgp-evpn-ethe-segm:ethernet-segment/srl-sys-netinst-bgp-evpn-ethe-segm:name";
      }
      description
        "If this ILM entry is for a pop label, and this label is below an EVPN label at the bottom of the stack,
         the label will identify an Ethernet Segment and forwarding in the network-instance may exclude the
         bridged subinterfaces associated with the Ethernet Segment";
    }
    uses srl-ip-rout-tbls:fib-programming-status {
      if-feature "srl-feat:fib-ilm-programming";
    }
  }

  grouping mpls-table-statistics {
    container statistics {
      description
        "Enter the statistics context";
      leaf total-entries {
        type srl-comm:zero-based-counter64;
        description
          "Total number of MPLS entries that have been downloaded to the FIB";
      }
      leaf fib-failed-entries {
        type srl-comm:zero-based-counter32;
        description
          "Total MPLS entries that failed FIB installation

           These entries were not installed successfully because datapath resources were unavailable.";
      }
    }
  }

  grouping mpls-tables-top {
    container mpls {
      description
        "Enter the mpls context

         The container for the MPLS routing table of the network instance.";
      list label-entry {
        key "label-value";
        leaf label-value {
          type srl-comm:mpls-label-non-reserved;
          description
            "The MPLS label value";
        }
        uses mpls-entry-common-fields;
      }
      uses table-summary {
        if-feature "srl-feat:mpls-fib-summary";
      }
      uses mpls-table-statistics;
    }
  }

  augment "/srl-netinst:network-instance/srl-netinst:route-table" {
    uses mpls-tables-top;
  }
}
