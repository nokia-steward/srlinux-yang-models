module srl_nokia-bgp-evpn-bgp-instance-mpls-bridge-table-statistics {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:l2-mac:bgp-evpn-bgp-instance-mpls-bridge-table-statistics";
  prefix srl-bgp-evpn-bgp-inst-mpls-brid-tbl-stat;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-network-instance {
    prefix srl-netinst;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-bgp-evpn {
    prefix srl-bgp-evpn;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for bridge-table unicast destinations on the bgp-evpn mpls instance

     Copyright 2022-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2022-03-31 {
    description
      "SR Linux 22.3.1";
  }

  grouping evpn-mpls-bridge-table-statistics-top {
    description
      "Statistics related to the bridge-table.";
    container statistics {
      config false;
      leaf active-entries {
        type srl-comm:zero-based-counter64;
        description
          "The total number of entries that are active on the evpn-mpls instance.";
        srl-exts:show-importance "high";
      }
      leaf total-entries {
        type srl-comm:zero-based-counter64;
        description
          "The total number of macs, active and inactive, on the evpn-mpls instance.";
        srl-exts:show-importance "high";
      }
      leaf failed-entries {
        type srl-comm:zero-based-counter64;
        description
          "The total number of macs, which have not been programmed on at least one slot.";
        srl-exts:show-importance "high";
      }
      list mac-type {
        key "type";
        description
          "The type of the mac on the evpn-mpls instance.";
        leaf type {
          type srl-comm:mac-type;
          srl-exts:show-importance "high";
        }
        leaf active-entries {
          type srl-comm:zero-based-counter64;
          description
            "The total number of entries of this type on the evpn-mpls instance.";
          srl-exts:show-importance "high";
        }
        leaf total-entries {
          type srl-comm:zero-based-counter64;
          description
            "The total number of macs of this type, active and inactive, on the evpn-mpls instance.";
          srl-exts:show-importance "high";
        }
        leaf failed-entries {
          type srl-comm:zero-based-counter64;
          description
            "The total number of macs of this type, which have not been programmed on at least one slot";
          srl-exts:show-importance "high";
        }
      }
      description
        "Enter the statistics context";
    }
  }

  augment "/srl-netinst:network-instance/srl-netinst:protocols/srl-netinst:bgp-evpn/srl-bgp-evpn:bgp-instance/srl-bgp-evpn:mpls/srl-bgp-evpn:bridge-table" {
    uses evpn-mpls-bridge-table-statistics-top;
  }
}
