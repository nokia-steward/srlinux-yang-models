module srl_nokia-bridge-table-mac-table {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:l2-mac:bridge-table-mac-table";
  prefix srl-brid-tbl-mac-tbl;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-network-instance {
    prefix srl-netinst;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This yang file gives a description of bridge table configuration.

     Copyright 2020-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-10-31 {
    description
      "SR Linux 25.10.1";
  }
  revision 2024-10-31 {
    description
      "SR Linux 24.10.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }
  revision 2020-06-30 {
    description
      "SR Linux 20.6.1";
  }

  grouping bridge-table-mac-table-top {
    container mac-table {
      config false;
      list mac {
        key "address";
        description
          "macs learnt on the bridging instance";
        leaf address {
          type srl-comm:mac-address;
        }
        leaf destination-type {
          type srl-comm:destination-type;
          srl-exts:show-importance "high";
          description
            "the type of the destination the mac installed against in the fdb.";
        }
        leaf destination-index {
          type uint64;
          srl-exts:show-importance "high";
          description
            "A system-wide unique identifier of a subinterface object (system allocated).";
        }
        leaf type {
          type srl-comm:mac-type;
          srl-exts:show-importance "high";
          description
            "the type of the mac installed in the fib.";
        }
        leaf last-update {
          type srl-comm:date-and-time-delta;
          srl-exts:show-importance "high";
          description
            "The date and time of the last update of this mac";
        }
        leaf not-programmed-reason {
          type enumeration {
            enum mac-limit;
            enum failed-on-slots;
            enum no-destination-index;
            enum reserved;
          }
          description
            "The reason why the mac is not programmed";
        }
        leaf-list failed-slots {
          type uint8 {
            range "1..18";
          }
          description
            "The list of slot IDs corresponding to the linecards that did not successfully program the mac";
        }
        leaf destination {
          type string;
          srl-exts:show-importance "high";
          description
            "the name of the destination where the mac is programmed against.";
        }
        leaf is-protected {
          type boolean;
          srl-exts:show-importance "high";
          description
            "Indicates if the mac is protected in the hardware.";
        }
        leaf group-based-policy-tag {
          if-feature "srl-feat:group-based-policy";
          type uint16 {
            range "0..65535";
          }
          srl-exts:show-importance "high";
          description
            "The group-based-policy tag value associated to this mac address";
        }
      }
      description
        "Enter the mac-table context";
    }
  }

  grouping mac-table-statistics {
    container statistics {
      config false;
      leaf active-entries {
        type srl-comm:zero-based-counter64;
        description
          "The total number of entries that are active in the mac-table.";
        srl-exts:show-importance "high";
      }
      leaf total-entries {
        type srl-comm:zero-based-counter64;
        description
          "The total number of macs, active and inactive, that are present in the mac-table.";
        srl-exts:show-importance "high";
      }
      leaf failed-entries {
        type srl-comm:zero-based-counter64;
        description
          "The total number of macs, which have not been programmed on atleast one slot";
        srl-exts:show-importance "high";
      }
      list mac-type {
        key "type";
        description
          "the type of the mac installed in the fib.";
        leaf type {
          type srl-comm:mac-type;
          srl-exts:show-importance "high";
        }
        leaf active-entries {
          type srl-comm:zero-based-counter64;
          description
            "The total number of entries of this type that are active in the mac-table.";
          srl-exts:show-importance "high";
        }
        leaf total-entries {
          type srl-comm:zero-based-counter64;
          description
            "The total number of macs of this type , active and inactive, that are present in the mac-table.";
          srl-exts:show-importance "high";
        }
        leaf failed-entries {
          type srl-comm:zero-based-counter64;
          description
            "The total number of macs of this type, which have not been programmed on atleast one slot";
          srl-exts:show-importance "high";
        }
      }
      description
        "Enter the statistics context";
    }
  }

  augment "/srl-netinst:network-instance/srl-netinst:bridge-table" {
    uses bridge-table-mac-table-top;
    uses mac-table-statistics;
  }
}
