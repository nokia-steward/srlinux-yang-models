module srl_nokia-tools-connection-point-bridge-table-mac-duplication {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:l2-mac:tools-connection-point-bridge-table-mac-duplication";
  prefix srl-tool-conn-poin-brid-tbl-mac-dupl;

  import srl_nokia-tools-network-instance {
    prefix srl-tool-netinst;
  }
  import srl_nokia-tools-interfaces-bridge-table-mac-duplication {
    prefix srl-tool-ifs-brid-tbl-mac-dupl;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for connection-point bridge-table mac duplication operational commands

     Copyright 2024-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }

  augment "/srl-tool-netinst:network-instance/srl-tool-netinst:connection-point/srl-tool-netinst:bridge-table" {
    uses srl-tool-ifs-brid-tbl-mac-dupl:tools-bridge-table-mac-duplication-top;
  }
}
