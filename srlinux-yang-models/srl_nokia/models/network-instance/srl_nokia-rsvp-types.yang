module srl_nokia-rsvp-types {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:mpls:rsvp-types";
  prefix srl-rsvp-type;

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This YANG module defines the common data types used by the Resource reSerVation Protocol (RSVP).

     Copyright 2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }

  typedef rsvp-te-threshold-level {
    type int32 {
      range "0..100";
    }
    description
      "Is an integer in the range of (0..100) that defines the traffic engineering (TE) threshold level.";
  }

  typedef bandwidth-mbps {
    type uint64;
    units "Mbps";
    description
      "Bandwidth in megabits per second.";
  }

  typedef bandwidth-kbps {
    type uint64;
    units "Kbps";
    description
      "Bandwidth in kilobits per second.";
  }
}
