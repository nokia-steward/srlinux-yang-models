module srl_nokia-tools-ldp {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:ldp:tools-ldp";
  prefix srl-tool-ldp;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-tools-network-instance {
    prefix srl-tool-netinst;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for LDP operational commands

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2024-10-31 {
    description
      "SR Linux 24.10.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }
  revision 2023-10-31 {
    description
      "SR Linux 23.10.1";
  }
  revision 2021-06-30 {
    description
      "SR Linux 21.6.1";
  }

  grouping ldp-tools-top {
    container ldp {
      if-feature "srl-feat:ldp";
      presence "Configure the LDP protocol";
      description
        "Operational tools commands for LDP.";
      container discovery {
        container interfaces {
          list interface {
            key "name";
            leaf name {
              type srl-comm:subinterface-eth-lag;
              description
                "Reference type to a specific subinterface of the form <interface-name>.<subinterface-index>";
            }
            leaf reset {
              if-feature "srl-feat:ldp-interface-reset";
              type empty;
              description
                "Reset LDP interface";
            }
            container ipv4 {
              container statistics {
                leaf clear {
                  type empty;
                  description
                    "Resets all the LDP instance state counters to zero";
                }
                description
                  "Enter the statistics context";
              }
              leaf reset {
                if-feature "srl-feat:ldp-interface-reset";
                type empty;
                description
                  "Reset IPv4 LDP interface";
              }
              description
                "Enter the ipv4 context";
            }
            container ipv6 {
              if-feature "srl-feat:ldp-ipv6";
              container statistics {
                leaf clear {
                  type empty;
                  description
                    "Resets all the LDP instance state counters to zero";
                }
                description
                  "Enter the statistics context";
              }
              leaf reset {
                if-feature "srl-feat:ldp-interface-reset";
                type empty;
                description
                  "Reset IPv6 LDP interface";
              }
              description
                "Enter the ipv6 context";
            }
          }
          description
            "Enter the interfaces context";
        }
        container targeted {
          if-feature "srl-feat:ldp-targeted";
          container ipv4 {
            list target {
              key "remote-address";
              leaf remote-address {
                type srl-comm:ipv4-address;
                description
                  "Reference to neighbor address of the targeted LDP adjacency.";
              }
              container statistics {
                leaf clear {
                  type empty;
                  description
                    "Resets all the LDP target counters to zero";
                }
                description
                  "Enter the statistics context";
              }
            }
            description
              "Enter the ipv4 context";
          }
          container ipv6 {
            if-feature "srl-feat:ldp-ipv6";
            list target {
              key "remote-address";
              leaf remote-address {
                type srl-comm:ipv6-address;
                description
                  "Reference to neighbor address of the targeted LDP adjacency.";
              }
              container statistics {
                leaf clear {
                  type empty;
                  description
                    "Resets all the LDP target counters to zero";
                }
                description
                  "Enter the statistics context";
              }
            }
            description
              "Enter the ipv6 context";
          }
          description
            "Enter the targeted context";
        }
        description
          "Enter the discovery context";
      }
      container peers {
        list peer {
          key "lsr-id label-space-id";
          description
            "List of peers.";
          leaf lsr-id {
            type srl-comm:ip-address;
            description
              "The LSR ID of the peer, to identify the globally unique LSR. This leaf is used together with the leaf 'label-space-id' to form the LDP ID.";
          }
          leaf label-space-id {
            type uint16;
            description
              "The Label Space ID of the peer, to identify a specific label space within the LSR. This is the last two octets of the LDP ID. This leaf is used together with the leaf 'lsr-id' to form the LDP ID.";
          }
          leaf reset {
            type empty;
            description
              "Reset the LDP session by closing the TCP connection and establishing a new one.";
          }
          container statistics {
            leaf clear {
              type empty;
              description
                "Resets all the LDP instance state counters to zero";
            }
            description
              "Enter the statistics context";
          }
        }
        description
          "Enter the peers context";
      }
      container reset-overload {
        presence "Reset the overload state of LDP";
      }
      container statistics {
        leaf clear {
          type empty;
          description
            "Resets all the LDP instance state counters to zero";
        }
        description
          "Enter the statistics context";
      }
      container targeted-auto-rx {
        if-feature "srl-feat:ldp-ipv4-auto-rx-tx-targeted";
        leaf hold-time {
          type uint32 {
            range "1..65535";
          }
          units "seconds";
          description
            "Hold-time during which new auto-rx targeted peers will not be generated";
        }
        description
          "Enter the targeted-auto-rx context";
      }
    }
  }

  augment "/srl-tool-netinst:network-instance/srl-tool-netinst:protocols" {
    uses ldp-tools-top;
  }
}
