module srl_nokia-tools-mld {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:igmp:tools-mld";
  prefix srl-tool-mld;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-tools-network-instance {
    prefix srl-tool-netinst;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for MLD operational commands

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2023-03-31 {
    description
      "SR Linux 23.3.1";
  }
  revision 2022-11-30 {
    description
      "SR Linux 22.11.1";
  }
  revision 2022-03-31 {
    description
      "SR Linux 22.3.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }

  grouping mld-tools-top {
    container mld {
      if-feature "srl-feat:mld";
      presence "Send operational commands to IGMP manager";
      container version {
        leaf clear {
          type empty;
          description
            "Reset the MLD operational version for all interfaces";
        }
        description
          "Enter the version context";
      }
      container statistics {
        leaf clear {
          type empty;
          description
            "Reset MLD statistics for all interfaces";
        }
        description
          "Enter the statistics context";
      }
      container membership-groups {
        leaf clear {
          type empty;
          description
            "Clear the MLD memberships for all interfaces";
        }
        list group {
          key "group";
          description
            "Multicast group membership";
          leaf group {
            type srl-comm:ipv6-address;
            description
              "Multicast address";
          }
          leaf clear {
            type empty;
            description
              "Clear all MLD memberships for this group on all interfaces";
          }
          list source {
            key "source";
            description
              "Source addresses of multicast";
            leaf source {
              type srl-comm:ipv6-address;
              description
                "Source address of multicast";
            }
            leaf clear {
              type empty;
              description
                "Clear all MLD memberships for this group on all interfaces";
            }
          }
        }
        description
          "Enter the membership-groups context";
      }
      list interface {
        description
          "List of MLD interfaces";
        key "interface-name";
        leaf interface-name {
          type srl-comm:subinterface-all;
          description
            "Reference to a specific subinterface of the form <interface-name>.<subinterface-index>";
        }
        container version {
          leaf clear {
            type empty;
            description
              "Reset the MLD operational version for this interface";
          }
          description
            "Enter the version context";
        }
        container statistics {
          leaf clear {
            type empty;
            description
              "Reset MLD statistics for this interface";
          }
          description
            "Enter the statistics context";
        }
        container membership-groups {
          leaf clear {
            type empty;
            description
              "Clear all MLD memberships for this interface";
          }
          list group {
            key "group";
            description
              "Multicast group membership";
            leaf group {
              type srl-comm:ipv6-address;
              description
                "Multicast address";
            }
            leaf clear {
              type empty;
              description
                "Clear all MLD memberships for this group on this interface";
            }
            list source {
              key "source";
              description
                "Source addresses of multicast";
              leaf source {
                type srl-comm:ipv6-address;
                description
                  "Source address of multicast";
              }
              leaf clear {
                type empty;
                description
                  "Clear all MLD memberships for this source on this interface";
              }
            }
          }
          description
            "Enter the membership-groups context";
        }
      }
    }
  }

  augment "/srl-tool-netinst:network-instance/srl-tool-netinst:protocols" {
    uses mld-tools-top;
  }
}
