module srl_nokia-tools-service-activation-testhead {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:mplsoam:tools-service-activation-testhead";
  prefix srl-tool-serv-acti-test;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-tools-oam {
    prefix srl-tool-oam;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }

  grouping sath-oam-top {
    container service-activation-testhead {
      presence "Tools commands for Service Activation Testhead";
      leaf clear {
        type empty;
        description
          "Clear all service activation testhead results";
      }
      list service-test {
        key "test-name";
        description
          "List of service tests";
        leaf test-name {
          description
            "Service activation test name";
          type srl-comm:restricted-name {
            length "1..64";
          }
        }
        leaf start {
          type empty;
          must 'not(../stop)' {
            error-message "start and stop are mutually exclusive";
          }
          description
            "Start new run of the service test with given test name";
        }
        leaf stop {
          type empty;
          must 'not(../start)' {
            error-message "start and stop are mutually exclusive";
          }
          description
            "Stop current run of the service test with given test name";
        }
        container clear {
          presence "Tools to clear past Service Activation Testhead result";
          description
            "Clear all or specific service test run results

             When run number omitted all run results are cleared.";
          leaf run {
            type uint32;
            description
              "Clear a specific service test run result";
          }
        }
      }
    }
  }

  augment "/srl-tool-oam:oam" {
    if-feature "srl-feat:service-activation-testhead";
    uses sath-oam-top;
  }
}
