module srl_nokia-dot1x-tunneling {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:dot1x-tunneling";
  prefix srl-dot1-tunn;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-interfaces {
    prefix srl-ifs;
  }
  import srl_nokia-system {
    prefix srl-sys;
  }
  import srl_nokia-dot1x {
    prefix srl-dot1;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module models dot1x tunneling under an interface

     Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2026-03-31 {
    description
      "SR Linux 26.3.1";
  }
  revision 2025-10-31 {
    description
      "SR Linux 25.10.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }

  grouping dot1x-tunneling-statistics {
    description
      "Grouping for dot1x tunneling statistics";
    leaf in-tunneled-packets {
      type srl-comm:zero-based-counter64;
      description
        "System or interface level incoming 802.1x tunneled frames

         Cumulative of all Ethernet interfaces including all the tunneled 802.1x frames.
         802.1x frames are identified by a destination MAC value of 01:80:c2:00:00:03 and EtherType value of 0x888e.";
    }
    leaf in-trap-to-cpu-packets {
      type srl-comm:zero-based-counter64;
      description
        "System or interface level incoming 802.1x frames copied to CPU

         Cumulative of all Ethernet interfaces including all the copy-to-cpu 802.1x frames.
         802.1x frames are identified by a destination MAC value of 01:80:c2:00:00:03 and EtherType value of 0x888e.";
    }
    leaf last-clear {
      type srl-comm:date-and-time-delta;
      description
        "Timestamp of the last time the 802.1x counters were cleared";
    }
  }

  grouping dot1x-tunneling-interface-statistics {
    description
      "Grouping for interface dot1x tunneling statistics";
    container statistics {
      description
        "Enter the statistics context

         Enclosing container for interface dot1x tunneling statistics";
      if-feature "srl-feat:dot1x-interface-stats";
      config false;
      uses dot1x-tunneling-statistics;
    }
  }

  grouping dot1x-tunneling-top {
    description
      "Grouping for dot1x tunneling

       By default all dot1x packets on this interface is extracted to CPM.
       Note this configuration can be overwritten by l2cp-transparency.
       If l2cp-transparency tunnel-all-l2cp is enabled setting the dot1x-tunneling to false will be overwritten.";
    container tunnel {
      description
        "Enter the tunnel context

         Enclosing container for dot1x tunneling";
      if-feature "srl-feat:dot1x-tunnel";
      leaf tunnel-all {
        if-feature "srl-feat:dot1x-tunnel-tunnel-all";
        description
          "tunnel all dot1x PDUs through the interface

           tunnel untagged and tagged dot1x PDUs.";
        must "starts-with(../../../../srl-ifs:name, 'ethernet') or . = false()" {
          srl-exts:if-feature "srl-feat:dot1x-authenticator-lag";
          error-message "dot1x tunneling not supported on this interface";
        }
        type boolean;
        default "false";
      }
      leaf untagged {
        if-feature "srl-feat:dot1x-tunnel-detail";
        description
          "tunnel untagged dot1x PDUs through the interface";
        must "starts-with(../../../../srl-ifs:name, 'ethernet') or . = false()" {
          srl-exts:if-feature "srl-feat:dot1x-authenticator-lag";
          error-message "dot1x untagged tunneling not supported on this interface";
        }
        type boolean;
        default "false";
      }
      leaf single-tagged {
        if-feature "srl-feat:dot1x-tunnel-detail";
        description
          "tunnel single tagged dot1x PDUs through the interface";
        must "starts-with(../../../../srl-ifs:name, 'ethernet') or . = true()" {
          srl-exts:if-feature "srl-feat:dot1x-authenticator-lag";
          error-message "dot1x single tagged tunneling not supported on this interface";
        }
        type boolean;
        default "true";
      }
      leaf double-tagged {
        if-feature "srl-feat:dot1x-tunnel-detail";
        description
          "tunnel double tagged dot1x PDUs through the interface";
        must "starts-with(../../../../srl-ifs:name, 'ethernet') or . = true()" {
          srl-exts:if-feature "srl-feat:dot1x-authenticator-lag";
          error-message "dot1x double tagged tunneling not supported on this interface";
        }
        type boolean;
        default "true";
      }
      leaf oper-rule {
        description
          "The operational state of the TCAM rule applied to ingress dot1x frames";
        config false;
        srl-exts:show-importance "high";
        type srl-comm:l2cp-oper-rule-state;
      }
      uses dot1x-tunneling-interface-statistics;
    }
  }

  grouping system-dot1x-tunnel-statistics {
    description
      "Grouping for system dot1x tunneling statistics";
    container statistics {
      if-feature "srl-feat:dot1x-tunnel-system-stats";
      description
        "Enter the statistics context

         Enclosing container for system dot1x tunneling statistics";
      config false;
      uses dot1x-tunneling-statistics;
    }
  }

  grouping system-dot1x-tunnel {
    description
      "Grouping for system dot1x tunneling";
    container tunnel {
      description
        "Enter the tunnel context

         Enclosing container for system dot1x tunneling";
      config false;
      uses system-dot1x-tunnel-statistics;
      action clear {
        srl-exts:telemetry-capability "unsupported";
        if-feature "srl-feat:tools-as-modeled-actions-same-io";
        description
          "Execute the clear action

           Clears the statistics for interface and system level 802.1x";
      }
    }
  }

  augment "/srl-ifs:interface/srl-ifs:ethernet/srl-dot1:dot1x" {
    if-feature "srl-feat:dot1x-tunnel";
    uses dot1x-tunneling-top;
  }

  augment "/srl-sys:system/srl-dot1:dot1x" {
    if-feature "srl-feat:dot1x-tunnel";
    uses system-dot1x-tunnel;
  }
}
