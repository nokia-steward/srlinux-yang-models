module srl_nokia-seamless-bfd {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:bfd:seamless-bfd";
  prefix srl-seam-bfd;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-network-instance {
    prefix srl-netinst;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This yang file gives a description of bfd protocol
     configuration.

     Copyright 2024-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }

  grouping seamless-bfd {
    container bfd {
      if-feature "srl-feat:seamless-bfd";
      description
        "Enter the bfd context

         Container for BFD related network-instance related configuration";
      container seamless-bfd {
        description
          "Enter the seamless-bfd context

           Container for BFD related network-instance related configuration";
        list peer {
          key "address";
          leaf address {
            type srl-comm:ip-address;
            description
              "An IPv4 or IPv6 address of the farend seamless-bfd descriminator binding";
          }
          leaf discriminator {
            type uint32;
            description
              "Static seamless-BFD discriminator for the farend binding";
          }
        }
        list reflector {
          key "name";
          description
            "List of seamless BFD reflector instances";
          max-elements 1;
          leaf name {
            type srl-comm:name;
            description
              "A name for the local seamless-bfd reflector agent";
          }
          leaf local-discriminator {
            type uint32 {
              range "524288..526335";
            }
            description
              "Seamless-BFD discriminator for the local reflector agent";
          }
          leaf admin-state {
            type srl-comm:admin-state;
            description
              "Used to administratively enable or disable seamless-bfd reflector";
          }
          leaf description {
            type srl-comm:description;
            description
              "Description of the seamless-bfd reflector";
          }
        }
      }
    }
  }

  augment "/srl-netinst:network-instance" {
    uses seamless-bfd;
  }
}
