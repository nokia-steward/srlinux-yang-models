module srl_nokia-platform-resource-monitoring {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:chassis:platform-resource-monitoring";
  prefix srl-plat-reso-moni;

  import srl_nokia-platform {
    prefix srl-plat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines configuration and operational data for system-wide monitoring of critical resources

     Copyright 2019-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2019-11-30 {
    description
      "SR Linux 19.11.1";
  }

  augment "/srl-plat:platform" {
    container resource-monitoring {
      description
        "Enter the resource-monitoring context";
    }
  }
}
