module srl_nokia-oam-pm-ip {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:twamp:oam-pm-ip";
  prefix srl-oam-pm-ip;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-interfaces {
    prefix srl-ifs;
  }
  import srl_nokia-ippm-source-udp-pool {
    prefix srl-ippm-src-udp-pool;
  }
  import srl_nokia-oam {
    prefix srl-oam;
  }
  import srl_nokia-oam-pm {
    prefix srl-oam-pm;
  }
  import srl_nokia-oam-pm-types {
    prefix srl-oam-pm-type;
  }
  import srl_nokia-network-instance {
    prefix srl-netinst;
  }
  import srl_nokia-qos {
    prefix srl-qos;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This YANG module contains the management data definitions for
     IP Performance Monitoring.

     Copyright 2024-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }
  revision 2024-10-31 {
    description
      "SR Linux 24.10.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }

  augment "/srl-oam:oam/srl-oam:performance-monitoring" {
    if-feature "srl-feat:oam-pm and srl-feat:oam-pm-ip";
    container ip {
      presence "OAM Performance Monitoring using STAMP";
      uses srl-oam-pm:oam-pm-resources;
      container delay {
        uses srl-oam-pm:bin-group;
        description
          "Enter the delay context";
      }
      container loss {
        uses srl-oam-pm:loss-events;
        description
          "Enter the loss context";
      }
      list session {
        key "session-name";
        description
          "Enter the session list instance which contains the test session configuration";
        uses srl-oam-pm:session;
        uses srl-oam-pm:measurement-interval;
        leaf destination-ip {
          mandatory true;
          type srl-comm:ip-address;
          description
            "Destination IP address for the IP test session";
        }
        leaf destination-udp-port {
          mandatory true;
          type srl-comm:port-number {
            range "1..65535";
          }
          description
            "Destination UDP port for the test session

             This must match the UDP listening port on the Session Reflector.";
        }
        leaf source-ip {
          mandatory true;
          type srl-comm:ip-address;
          description
            "Source IPv4 or IPv6 IP address to be used as the source address of the packet";
        }
        leaf source-udp-port {
          type srl-comm:port-number {
            range "0 | 64374..64383";
          }
          default "0";
          must "(. = 0) or /srl-oam:oam/srl-ippm-src-udp-pool:ippm/srl-ippm-src-udp-pool:source-udp-port-pools/srl-ippm-src-udp-pool:port[srl-ippm-src-udp-pool:port-number = current ()]/srl-ippm-src-udp-pool:application-assignment = 'oam-pm-ip'" {
            error-message "The source UDP port must be assigned to the oam-pm-ip application and the UDP port application-assignment cannot be modified if it is configured for any oam-pm-ip session";
          }
          description
            "Automatically allocate or statically configure the source UDP port for oam pm ip

             The value 0 will automatically select an available source UDP port from the dynamic range.  When selecting a source UDP port from the
             from the reserved STAMP pool [64374..64383] that port must be administratively assigned to the STAMP application attempting to use it.
             Once a UDP port in this range is assigned to one application it cannot be used by the other application.  When a test has been configured
             to use one of UDP ports from the reserved STAMP pool the application-assignment of that UDP port cannot be modified.

             Allocation of these UDP ports can be found at srl_nokia-udp-source-pool.yang model (path oam ippm source-udp-pools).";
        }
        leaf source-udp-port-in-use {
          config false;
          type srl-comm:port-number;
          description
            "Source UDP port used in the packet";
        }
        leaf network-instance {
          mandatory true;
          type leafref {
            path "/srl-netinst:network-instance/srl-netinst:name";
          }
          must "(/srl-netinst:network-instance[srl-netinst:name=current()]/srl-netinst:type = 'srl-netinst:ip-vrf' or 'srl-netinst:default')" {
            error-message "IP Performance Monitoring only operates on an existing network-instance of type ip-vrf or default";
          }
          description
            "The name of the network instance specific to this test session";
        }
        leaf dscp {
          type srl-comm:dscp;
          default "CS6";
          description
            "DSCP used in IP header of the STAMP PDU";
        }
        leaf forwarding-class {
          if-feature "srl-feat:qos";
          type leafref {
            path "/srl-qos:qos/srl-qos:forwarding-classes/srl-qos:forwarding-class/srl-qos:name";
          }
          description
            "The forwarding class

             When value not specified, the sgt-qos value will be used";
        }
        leaf profile {
          if-feature "srl-feat:qos";
          type srl-comm:rewrite-profile;
          description
            "The profile or drop precedence

             When value not specified, the sgt-qos value will be used";
        }
        leaf ttl {
          type uint32 {
            range "1..255";
          }
          default "255";
          description
            "TTL value for the IP packet";
        }
        container forwarding {
          presence "Enable the forwarding context";
          description
            "Control the local forwarding decision on the source";
          choice forwarding-choice {
            mandatory true;
            case next-hop {
              leaf next-hop {
                type srl-comm:ip-address;
                description
                  "IP address of the next hop

                   The next hop must have a valid route in the route-table of the network instance.";
              }
            }
            case interface {
              container interface-ref {
                leaf interface {
                  mandatory true;
                  type leafref {
                    path "/srl-ifs:interface/srl-ifs:name";
                  }
                  description
                    "Reference to a base interface, for example a port";
                }
                leaf subinterface {
                  mandatory true;
                  type leafref {
                    path "/srl-ifs:interface[srl-ifs:name=current()/../interface]/srl-ifs:subinterface/srl-ifs:index";
                  }
                  description
                    "Subinterface to send the test packet

                     The subinterface mut be a valid route to reach the destination";
                }
                description
                  "Enter the interface-ref context";
              }
            }
          }
        }
        container stamp {
          leaf admin-state {
            srl-exts:show-importance "high";
            type srl-comm:admin-state;
            default "disable";
            description
              "Administrative state of the STAMP test session";
          }
          uses srl-oam-pm:operational-states-errors;
          leaf stamp-session-identifier {
            srl-exts:show-importance "high";
            config false;
            type uint16;
            description
              "STAMP session identifier (SSID) included in the STAMP test packet";
          }
          uses srl-oam-pm:test-session;
          leaf pad-tlv-size {
            type uint32 {
              range "0| 3..9502";
            }
            default "0";
            units "bytes";
            description
              "The PAD TLV byte count used to increase the size of the base STAMP PDU

               A value '0' means no PAD TLV is added.  Any other value represents the size of the PAD TLV.";
          }
          leaf interval {
            type srl-oam-pm-type:oam-pm-interval;
            default "1s";
            description
              "The transmission rate of the STAMP packets";
          }
          container statistics {
            config false;
            leaf stamp-unrecognized-flag-received {
              type uint32;
              description
                "Indicates the count of packets in this sample window with the U (Unrecognized) bit set
                 in the flags field of the TLV.";
            }
            leaf stamp-malformed-flag-received {
              type uint32;
              description
                "Indicates the count of packets in this sample window with the M (Malformed) bit set in
                 the flags field of the TLV.";
            }
            description
              "Enter the statistics context";
          }
          container delay {
            leaf bin-group {
              srl-exts:show-importance "high";
              type leafref {
                path "../../../../delay/bin-group/bin-group-name";
              }
              default "default";
              description
                "Reference the bin group to be used for this session.  If not specified the 'default' bin-group will be used";
            }
            uses srl-oam-pm:bin-group-state;
            list measurement-result {
              config false;
              description
                "The test statistics for a delay measurement";
              key "mi-ro-type";
              leaf mi-ro-type {
                type srl-oam-pm-type:measurement-interval-ro-duration-type;
                description
                  "The duration of the measurement interval";
              }
              uses srl-oam-pm:measurement-interval-index-tracking;
              list index {
                key "index";
                leaf index {
                  type uint32;
                  description
                    "Measurement interval unique identifier";
                }
                uses srl-oam-pm:mi-common-state;
                container statistics {
                  uses srl-oam-pm:mi-delay-statistics;
                  description
                    "Enter the statistics context";
                }
              }
            }
            uses srl-oam-pm:delay-events-state;
            description
              "Enter the delay context";
          }
          container loss {
            uses srl-oam-pm:frame-loss-configuration;
            leaf loss-event {
              type leafref {
                path "../../../../loss/loss-events-template/loss-events-template-name";
              }
              description
                "The loss event template associated with this loss test session and measurement interval";
            }
            list measurement-result {
              config false;
              description
                "The test statistics for a delay measurement";
              key "mi-ro-type";
              leaf mi-ro-type {
                type srl-oam-pm-type:measurement-interval-ro-duration-type;
                description
                  "The duration of the measurement interval";
              }
              uses srl-oam-pm:measurement-interval-index-tracking;
              list index {
                key "index";
                leaf index {
                  type uint32;
                  description
                    "Interval identifier.";
                }
                uses srl-oam-pm:mi-common-state;
                container statistics {
                  uses srl-oam-pm:mi-general-loss-statistics;
                  container forward {
                    uses srl-oam-pm:mi-forward-loss;
                    uses srl-oam-pm:mi-directional-loss-statistics;
                    description
                      "Enter the forward context";
                  }
                  container backward {
                    uses srl-oam-pm:mi-backward-loss;
                    uses srl-oam-pm:mi-directional-loss-statistics;
                    description
                      "Enter the backward context";
                  }
                  description
                    "Enter the statistics context";
                }
              }
            }
            uses srl-oam-pm:loss-events-state;
            description
              "Enter the loss context";
          }
          description
            "Enter the stamp context";
        }
        action start {
          srl-exts:telemetry-capability "unsupported";
          if-feature "srl-feat:tools-as-modeled-actions-different-io-twamp-mgr";
          description
            "Execute the start action

             Start an OAM-PM on-demand session";
        }
        action stop {
          srl-exts:telemetry-capability "unsupported";
          if-feature "srl-feat:tools-as-modeled-actions-different-io-twamp-mgr";
          description
            "Execute the stop action

             Stop an OAM-PM on-demand session";
        }
        action clear {
          srl-exts:telemetry-capability "unsupported";
          if-feature "srl-feat:tools-as-modeled-actions-different-io-twamp-mgr";
          description
            "Execute the clear action

             Clear all raw bin statistics";
        }
      }
    }
  }
}
