module srl_nokia-interfaces-local-mirror-destination {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:mirror:interfaces-local-mirror-destination";
  prefix srl-ifs-loc-mirr-dst;

  import srl_nokia-interfaces {
    prefix srl-ifs;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for managing subinterfaces of type local-mirror-destination

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }
  revision 2023-03-31 {
    description
      "SR Linux 23.3.1";
  }
  revision 2022-11-30 {
    description
      "SR Linux 22.11.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }
  revision 2021-06-30 {
    description
      "SR Linux 21.6.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }

  grouping subinterface-local-mirror-destination-top {
    container local-mirror-destination {
      if-feature "srl-feat:mirroring";
      presence "Performs local-mirror-destination";
      description
        "Container for options related to local mirror destination";
      must "(../srl-ifs:type = 'local-mirror-dest')" {
        error-message "local-mirror-destination is only allowed on subinterfaces with type local-mirror-dest";
      }
      leaf admin-state {
        type srl-comm:admin-state;
        default "enable";
        description
          "The configurable state of the local mirror destination";
      }
      leaf oper-state {
        config false;
        type srl-comm:oper-state;
        description
          "The operational state of the local mirror destination";
      }
    }
  }

  augment "/srl-ifs:interface/srl-ifs:subinterface" {
    uses subinterface-local-mirror-destination-top;
  }
}
