module srl_nokia-interfaces-ethernet-segment-association {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:evpn:interfaces-ethernet-segment-association";
  prefix srl-ifs-ethe-segm-asso;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-interfaces {
    prefix srl-ifs;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This yang file gives a description of interface's ethernet-segment association

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2022-03-31 {
    description
      "SR Linux 22.3.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }

  grouping ethernet-segment-association-top {
    container ethernet-segment-association {
      config false;
      description
        "Enter the ethernet-segment-association context

         ethernet-segment association information.";
      leaf ethernet-segment {
        type srl-comm:name;
        description
          "The value of this leaf indicates the ethernet-segment, the
           sub-interface is associated to.";
      }
      leaf es-managed {
        type boolean;
        default "false";
        description
          "The value of this leaf indicates if the interface is managed
           by the ethernet-segment on the network-instance.";
      }
      leaf designated-forwarder {
        type boolean;
        default "false";
        description
          "The value of this leaf indicates if the interface is the designated
           forwarder for the ethernet-segment on the network-instance.";
      }
    }
  }

  augment "/srl-ifs:interface/srl-ifs:subinterface" {
    uses ethernet-segment-association-top;
  }
}
