module srl_nokia-tools-interfaces-ip-vrrp {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:vrrp:tools-interfaces-ip-vrrp";
  prefix srl-tool-ifs-ip-vrrp;

  import srl_nokia-tools-interfaces {
    prefix srl-tool-ifs;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for interface ip VRRP operational commands

     Copyright 2020-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2022-11-30 {
    description
      "SR Linux 22.11.1";
  }
  revision 2021-06-30 {
    description
      "SR Linux 21.6.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }
  revision 2020-06-30 {
    description
      "SR Linux 20.6.1";
  }

  grouping tools-interface-ip-vrrp-top {
    list vrrp-group {
      if-feature "srl-feat:vrrp";
      key "virtual-router-id";
      description
        "VRRP Group Specific Configuration under IPv4 context";
      leaf virtual-router-id {
        description
          "VRRP Group Index";
        type uint8;
      }
      container statistics {
        leaf clear {
          type empty;
        }
        description
          "Enter the statistics context";
      }
    }
  }

  augment "/srl-tool-ifs:interface/srl-tool-ifs:subinterface/srl-tool-ifs:ipv4/srl-tool-ifs:address" {
    uses tools-interface-ip-vrrp-top;
  }

  augment "/srl-tool-ifs:interface/srl-tool-ifs:subinterface/srl-tool-ifs:ipv6/srl-tool-ifs:address" {
    uses tools-interface-ip-vrrp-top;
  }
}
