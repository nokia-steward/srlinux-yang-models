module srl_nokia-if-ip-tags {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:chassis:if-ip-tags";
  prefix srl-if-ip-tags;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-routing-policy {
    prefix srl-rpol;
  }
  import srl_nokia-interfaces {
    prefix srl-ifs;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for assigninf tags to IP subnets of local subinterfaces

     Copyright 2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }

  grouping internal-tags {
    description
      "Grouping containing the configuration of internal tags";
    container internal-tags {
      description
        "Enter the internal-tags context

         Configuration and state of internal tags";
      leaf-list set-tag-set {
        max-elements 1;
        type leafref {
          path "/srl-rpol:routing-policy/srl-rpol:tag-set/srl-rpol:name";
        }
        description
          "Reference to a tag-set defined under routing-policy";
      }
    }
  }

  augment "/srl-ifs:interface/srl-ifs:subinterface/srl-ifs:ipv4/srl-ifs:address" {
    uses internal-tags;
    if-feature "srl-feat:subif-ip-tags and srl-feat:internal-tags";
  }

  augment "/srl-ifs:interface/srl-ifs:subinterface/srl-ifs:ipv6/srl-ifs:address" {
    uses internal-tags;
    if-feature "srl-feat:subif-ip-tags and srl-feat:internal-tags";
  }
}
