module srl_nokia-tools-interfaces-fhs-binding {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:fhs:tools-interfaces-fhs-binding";
  prefix srl-tool-ifs-fhs-bind;

  import srl_nokia-tools-interfaces {
    prefix srl-tool-ifs;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for interface fhs binding operational commands

     Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-03-31 {
    description
      "SR Linux 26.3.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }

  grouping tools-interface-fhs-binding {
    container fhs-binding {
      presence "Clear FHS binding";
      leaf clear {
        type empty;
      }
    }
  }

  augment "/srl-tool-ifs:interface/srl-tool-ifs:subinterface" {
    if-feature "srl-feat:ip-mac-binding";
    uses tools-interface-fhs-binding;
  }
}
