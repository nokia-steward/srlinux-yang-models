module srl_nokia-tools-interfaces-nbr-virtual-ip-discovery {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:arp-nd:tools-interfaces-nbr-virtual-ip-discovery";
  prefix srl-tool-ifs-nbr-virt-ip-disc;

  import srl_nokia-tools-interfaces {
    prefix srl-tool-ifs;
  }
  import srl_nokia-tools-interfaces-nbr {
    prefix srl-tool-ifs-nbr;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for interface ip Virtual IP discovery operational commands

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2022-06-30 {
    description
      "SR Linux 22.6.1";
  }
  revision 2022-03-31 {
    description
      "SR Linux 22.3.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }

  grouping tools-interfaces-nbr-virtual-ipv4-discovery-top {
    container virtual-ipv4-discovery {
      if-feature "srl-feat:virtual-ip-discovery";
      container statistics {
        leaf clear {
          type empty;
          description
            "Clears the global statistics for all the Virtual IP addresses";
        }
        description
          "Enter the statistics context";
      }
      list address {
        key "ipv4-address";
        description
          "The list of Virtual IP addresses";
        leaf ipv4-address {
          type srl-comm:ipv4-address;
          description
            "The virtual IPv4 address.";
        }
        container statistics {
          leaf clear {
            type empty;
            description
              "Clears the statistics for the Virtual IP addresses";
          }
          description
            "Enter the statistics context";
        }
      }
      description
        "Enter the virtual-ipv4-discovery context";
    }
  }

  grouping tools-interfaces-nbr-virtual-ipv6-discovery-top {
    container virtual-ipv6-discovery {
      if-feature "srl-feat:virtual-ip-discovery";
      container statistics {
        leaf clear {
          type empty;
          description
            "Clears the global statistics for all the Virtual IP addresses";
        }
        description
          "Enter the statistics context";
      }
      list address {
        key "ipv6-address";
        description
          "The list of Virtual IP addresses";
        leaf ipv6-address {
          type srl-comm:ipv6-address;
          description
            "The virtual IPv6 address.";
        }
        container statistics {
          leaf clear {
            type empty;
            description
              "Clears the statistics for the Virtual IP addresses";
          }
          description
            "Enter the statistics context";
        }
      }
      description
        "Enter the virtual-ipv6-discovery context";
    }
  }

  augment "/srl-tool-ifs:interface/srl-tool-ifs:subinterface/srl-tool-ifs:ipv4/srl-tool-ifs-nbr:arp" {
    uses tools-interfaces-nbr-virtual-ipv4-discovery-top;
  }

  augment "/srl-tool-ifs:interface/srl-tool-ifs:subinterface/srl-tool-ifs:ipv6/srl-tool-ifs-nbr:neighbor-discovery" {
    uses tools-interfaces-nbr-virtual-ipv6-discovery-top;
  }
}
