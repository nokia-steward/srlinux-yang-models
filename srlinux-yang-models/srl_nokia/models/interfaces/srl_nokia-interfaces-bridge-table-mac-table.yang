module srl_nokia-interfaces-bridge-table-mac-table {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:l2-mac:interfaces-bridge-table-mac-table";
  prefix srl-ifs-brid-tbl-mac-tbl;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-interfaces {
    prefix srl-ifs;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This yang file gives a description of mac entries installed in this interfac's bridge table.

     Copyright 2020-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2024-10-31 {
    description
      "SR Linux 24.10.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }
  revision 2020-06-30 {
    description
      "SR Linux 20.6.1";
  }

  grouping bridge-table-mac-table-top {
    container mac-table {
      config false;
      list mac {
        key "address";
        description
          "macs learnt on the bridging instance";
        leaf address {
          type srl-comm:mac-address;
        }
        leaf type {
          type srl-comm:mac-type;
          srl-exts:show-importance "high";
          description
            "the type of the mac installed in the fib.";
        }
        leaf last-update {
          type srl-comm:date-and-time-delta;
          srl-exts:show-importance "high";
          description
            "The date and time of the last update of this mac";
        }
        leaf not-programmed-reason {
          type enumeration {
            enum mac-limit;
            enum failed-on-slots;
            enum no-destination-index;
            enum reserved;
          }
          description
            "The reason why the mac is not programmed";
        }
        leaf-list failed-slots {
          type uint8 {
            range "1..18";
          }
          description
            "The list of slot IDs corresponding to the linecards that did not successfully program the mac";
        }
      }
      description
        "Enter the mac-table context";
    }
  }

  augment "/srl-ifs:interface/srl-ifs:subinterface/srl-ifs:bridge-table" {
    uses bridge-table-mac-table-top;
  }
}
