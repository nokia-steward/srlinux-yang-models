module srl_nokia-tools-dhcp-server {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:dhcp:tools-dhcp-server";
  prefix srl-tool-dhcp-serv;

  import srl_nokia-tools-system {
    prefix srl-tool-sys;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Model for dhcp server operational commands

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }

  grouping tools-system-dhcp-server-top {
    container dhcp-server {
      presence "Performs DHCP server function";
      list network-instance {
        description
          "List of network instances to run a dhcp server in";
        key "name";
        leaf name {
          type srl-comm:name;
          description
            "Network Instance";
        }
        container dhcpv4 {
          container statistics {
            leaf clear {
              type empty;
            }
            description
              "Enter the statistics context";
          }
          description
            "Enter the dhcpv4 context";
        }
        container dhcpv6 {
          container statistics {
            leaf clear {
              type empty;
            }
            description
              "Enter the statistics context";
          }
          description
            "Enter the dhcpv6 context";
        }
      }
    }
  }

  augment "/srl-tool-sys:system" {
    uses tools-system-dhcp-server-top;
  }
}
