module srl_nokia-system-network-instance-vxlan {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:vxlan:system-network-instance-vxlan";
  prefix srl-sys-netinst-vxla;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-system {
    prefix srl-sys;
  }
  import srl_nokia-system-network-instance {
    prefix srl-sys-netinst;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This yang file models configuration and state of VXLAN in the system network-instance.

     Copyright 2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }

  grouping system-network-instance-vxlan-top {
    description
      "Top-level grouping containing the configuration and state of VXLAN in the system network-instance";
    container vxlan {
      if-feature "srl-feat:evpn-anycast-l3-subnet or srl-feat:vxlan-source-vtep-security";
      presence "Configure VXLAN in the system network-instance";
      leaf router-mac-address {
        if-feature "srl-feat:evpn-anycast-l3-subnet";
        type srl-comm:unicast-mac-address;
        description
          "The router MAC address for VXLAN across all routed vxlan-interfaces";
      }
      leaf source-vtep-security {
        if-feature "srl-feat:vxlan-source-vtep-security";
        type boolean;
        default "true";
        description
          "Whether to enable vxlan source vtep security for all vxlan-interfaces";
      }
    }
  }

  augment "/srl-sys:system/srl-sys-netinst:network-instance/srl-sys-netinst:protocols" {
    uses system-network-instance-vxlan-top;
  }
}
