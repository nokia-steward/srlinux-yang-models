module srl_nokia-tools-netconf-server {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:netconf:tools-netconf-server";
  prefix srl-tool-netc-serv;

  import srl_nokia-tools-system {
    prefix srl-tool-sys;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "Tools related to the NETCONF server

     Copyright 2024-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }

  grouping tools-netconf-server-top {
    list netconf-server {
      key "name";
      leaf name {
        type srl-comm:restricted-name;
        description
          "NETCONF server instance name";
      }
      container statistics {
        leaf clear {
          type empty;
          description
            "Clear statistics information for the NETCONF server instance";
        }
        description
          "Enter the statistics context";
      }
      list session {
        key "session-id";
        leaf session-id {
          type uint32 {
            range "1..max";
          }
        }
        leaf clear {
          type empty;
          description
            "Clear the NETCONF server instance session";
        }
        container statistics {
          leaf clear {
            type empty;
            description
              "Clear statistics information for the NETCONF session";
          }
          description
            "Enter the statistics context";
        }
      }
    }
  }

  augment "/srl-tool-sys:system" {
    if-feature "srl-feat:netconf";
    srl-exts:first-released "24.7.1";
    uses tools-netconf-server-top;
  }
}
