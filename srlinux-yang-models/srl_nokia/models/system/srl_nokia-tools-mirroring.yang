module srl_nokia-tools-mirroring {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:mirror:tools-mirroring";
  prefix srl-tool-mirr;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-tools-system {
    prefix srl-tool-sys;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines tools command for mirroring (SPAN/ERSPAN).

     Copyright 2023-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }
  revision 2023-07-31 {
    description
      "SR Linux 23.7.1";
  }

  grouping tools-mirroring-top {
    description
      "Top-level grouping containing tools mirroring.";
    container mirroring {
      presence "Configure tools mirroring";
      if-feature "srl-feat:mirroring-tools-mirror-dest-statistics";
      list mirroring-instance {
        key "name";
        leaf name {
          type string;
          description
            "A unique name identifying the mirroring instance";
        }
        uses mirror-destination-top;
      }
    }
  }

  grouping mirror-destination-top {
    container mirror-destination {
      description
        "Enter the mirror-destination context

         Mirror destination";
      container statistics {
        leaf clear {
          description
            "Clears the mirror destination statistics";
          type empty;
        }
        description
          "Enter the statistics context";
      }
    }
  }

  augment "/srl-tool-sys:system" {
    uses tools-mirroring-top;
  }
}
