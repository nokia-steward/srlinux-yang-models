module srl_nokia-tools-aaa {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:aaa:tools-aaa";
  prefix srl-tool-aaa;

  import srl_nokia-tools-system {
    prefix srl-tool-sys;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines operational commands related to AAA.

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2023-07-31 {
    description
      "SR Linux 23.7.1";
  }
  revision 2022-06-30 {
    description
      "SR Linux 22.6.1";
  }
  revision 2021-11-30 {
    description
      "SR Linux 21.11.1";
  }

  grouping aaa-tools-top {
    container authentication {
      description
        "Enter the authentication context

         Operational commands related to authentication";
      list session {
        description
          "List of active sessions in the system";
        key "id";
        leaf id {
          description
            "System generated session ID";
          type int32;
        }
        leaf disconnect {
          description
            "Disconnect the cli session, requesting the cli to terminate";
          type empty;
        }
        leaf stop {
          description
            "Stop the aaa session, the process belonging to the session will be terminated gracefully";
          type empty;
        }
      }
      list user {
        description
          "List of local users including admin and linuxadmin";
        key "username";
        leaf username {
          type string;
        }
        leaf unlock {
          description
            "Unlock the user, This will change its lockout state into false";
          type empty;
        }
        leaf force-password-change {
          if-feature "srl-feat:tools-force-pwd-change";
          description
            "Set change-on-first-login to true for this user

             This command will only take effect if the feature change-on-first-login is currently set to true.";
          type empty;
        }
      }
      leaf force-all-user-password-change {
        if-feature "srl-feat:tools-force-pwd-change";
        description
          "Set change-on-first-login to true for all users

           This command will only take effect if the feature change-on-first-login is currently set to true.";
        type empty;
      }
    }
    container authorization {
      if-feature "srl-feat:gnsi-authz";
      description
        "Enter the authorization context

         Operational commands relating to authorization";
    }
  }

  grouping aaa-top {
    container aaa {
      presence "Configure tools system AAA";
      srl-exts:first-released "21.11.1";
      description
        "Top-level container for operational commands related to AAA";
      uses aaa-tools-top;
    }
  }

  augment "/srl-tool-sys:system" {
    uses aaa-top;
  }
}
