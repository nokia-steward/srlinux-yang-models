module srl_nokia-system {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:general:system";
  prefix srl-sys;

  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines configuration and operational state data
     related to system management

     Portions of this model reuse data definitions or structure from
     RFC 7317 - A YANG Data Model for System Management

     Copyright 2019-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }
  revision 2025-03-31 {
    description
      "SR Linux 25.3.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }
  revision 2022-03-31 {
    description
      "SR Linux 22.3.1";
  }
  revision 2020-06-30 {
    description
      "SR Linux 20.6.1";
  }
  revision 2019-11-30 {
    description
      "SR Linux 19.11.1";
  }

  grouping management-top {
    container management {
      description
        "Enter the management context

         Enclosing container for options relating to management server";
    }
  }

  grouping control-plane-traffic {
    container control-plane-traffic {
      description
        "Enter the control-plane-traffic context

         Container for the control plane traffic.";
      container output {
        description
          "Enter the output context

           Defines parameters determining the handling of system generated traffic.";
      }
      container input {
        description
          "Enter the input context

           Container for ingress control plane traffic.";
      }
    }
  }

  container system {
    description
      "Enter the system context

       Enclosing container for system management";
    leaf-list features {
      if-feature "not srl-feat:platform-imgmt";
      srl-exts:first-released "20.6.1";
      config false;
      description
        "Features enabled on this platform";
      type srl-comm:name;
    }
    leaf-list trace-options {
      srl-exts:first-released "19.11.1";
      description
        "Management server trace options";
      type enumeration {
        enum request;
        enum response;
        enum common;
      }
    }
    uses management-top {
      if-feature "not srl-feat:platform-imgmt";
    }
    uses control-plane-traffic {
      if-feature "not srl-feat:platform-imgmt";
    }
  }
}
