module srl_nokia-system-coordinates {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:linux:system-coordinates";
  prefix srl-sys-coor;

  import srl_nokia-system {
    prefix srl-sys;
  }
  import srl_nokia-system-info {
    prefix srl-sys-info;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines configuration related system banners

     Copyright 2025-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2025-07-31 {
    description
      "SR Linux 25.7.1";
  }

  grouping coordinates-config-top {
    container coordinates {
      description
        "Enter the coordinates context

         Contains configuration and state related to system coordinates";
      leaf latitude {
        type srl-comm:coordinate-location-latitude;
        description
          "Decimal latitude between -90 and 90 to a maximum of 6 decimal places";
      }
      leaf longitude {
        type srl-comm:coordinate-location-longitude;
        description
          "Decimal longitude between -180 and 180 to a maximum of 6 decimal places";
      }
      leaf height {
        type srl-comm:coordinate-location-height;
        description
          "Height in meters";
      }
    }
  }

  grouping coordinates-top {
    uses coordinates-config-top;
  }

  augment "/srl-sys:system/srl-sys-info:information" {
    if-feature "srl-feat:location-coordinates";
    uses coordinates-top;
  }
}
