module srl_nokia-system-network-instance {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:net-inst:system-network-instance";
  prefix srl-sys-netinst;

  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-system {
    prefix srl-sys;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This yang file models configuration and state of the system network-instance.

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }
  revision 2021-06-30 {
    description
      "SR Linux 21.6.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }

  grouping system-network-instance-top {
    description
      "Top-level grouping containing the system network-instance configuration and state.";
    container network-instance {
      presence "Configure the system network-instance.";
      container protocols {
        description
          "Enter the protocols context

           The routing protocols that are enabled for this
           network-instance.";
        container evpn {
          if-feature "srl-feat:evpn-mh";
          presence "System network-instance evpn configuration and state.";
        }
      }
    }
  }

  augment "/srl-sys:system" {
    uses system-network-instance-top;
  }
}
