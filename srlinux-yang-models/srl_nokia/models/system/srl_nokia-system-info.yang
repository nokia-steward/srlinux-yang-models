module srl_nokia-system-info {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:linux:system-info";
  prefix srl-sys-info;

  import srl_nokia-system {
    prefix srl-sys;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import openconfig-metadata {
    prefix oc-meta;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines configuration and state related to miscellaneous system information

     Copyright 2019-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2026-03-31 {
    description
      "SR Linux 26.3.1";
  }
  revision 2024-03-31 {
    description
      "SR Linux 24.3.1";
  }
  revision 2023-03-31 {
    description
      "SR Linux 23.3.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }
  revision 2020-06-30 {
    description
      "SR Linux 20.6.1";
  }
  revision 2019-11-30 {
    description
      "SR Linux 19.11.1";
  }

  grouping information-top {
    container information {
      description
        "Enter the information context

         Top-level container for system information configuration and state";
      leaf contact {
        type string;
        description
          "The system contact

           This field represents contact information for the person or group that maintains the system. This field is exposed via SNMP at the sysContact OID.";
      }
      leaf location {
        type string;
        description
          "The system location

           This field represents the location of the system, and is commonly used by inventory management systems to group elements together. This field is exposed via SNMP at the sysLocation OID.";
      }
      leaf description {
        type string;
        description
          "The system description

           This field is system generated, and is a combination of the system host name, software version, kernel version, and build date. The template for this field is: SRLinux-<version> <hostname> <kernel> <build date>. This field is exposed via SNMP at the sysDescr OID.";
        config false;
      }
      leaf current-datetime {
        type srl-comm:date-and-time-delta;
        description
          "The current system date and time";
        config false;
      }
      leaf last-booted {
        type srl-comm:date-and-time-delta;
        description
          "The date and time the system was last booted";
        config false;
      }
      leaf up-time {
        type srl-comm:date-and-time-delta;
        description
          "The date and time the chassis was last booted";
        config false;
      }
      leaf up-time-counter {
        type uint64;
        description
          "The date and time the chassis was last booted in nanoseconds";
        config false;
      }
      leaf version {
        type string;
        description
          "The system version

           This field represents the version of the management server";
        config false;
      }
      uses oc-meta:protobuf-metadata {
        if-feature "srl-feat:openconfig";
      }
    }
  }

  grouping sysinfo-top {
    uses information-top;
  }

  augment "/srl-sys:system" {
    uses sysinfo-top;
  }
}
