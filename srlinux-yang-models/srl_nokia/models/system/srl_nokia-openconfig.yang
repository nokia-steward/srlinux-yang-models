module srl_nokia-openconfig {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:oc-mgmt:openconfig";
  prefix srl-oc;

  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-system {
    prefix srl-sys;
  }
  import srl_nokia-lldp {
    prefix srl-lldp;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines configuration and operational state data
     related to the OpenConfig schema

     Copyright 2022-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2022-06-30 {
    description
      "SR Linux 22.6.1";
  }
  revision 2022-03-31 {
    description
      "SR Linux 22.3.1";
  }

  grouping openconfig-top {
    container openconfig {
      if-feature "srl-feat:openconfig";
      presence "Start OpenConfig management server";
      description
        "Top-level container for options relating to OpenConfig";
      leaf admin-state {
        description
          "Enable or disable the OpenConfig management server

           This will disable OpenConfig throughout the system, and bring any gRPC servers that use it operationally down.";
        type srl-comm:admin-state;
        must "(. = 'disable' or ../../../srl-lldp:lldp)" {
          error-message "OpenConfig can only be enabled if the lldp presence container is configured";
        }
      }
      leaf oper-state {
        config false;
        description
          "Indicates the operational state of the OpenConfig management server";
        type srl-comm:oper-state;
      }
    }
  }

  augment "/srl-sys:system/srl-sys:management" {
    srl-exts:first-released "22.6.1";
    uses openconfig-top;
  }
}
