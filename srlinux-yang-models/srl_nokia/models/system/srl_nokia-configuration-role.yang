module srl_nokia-configuration-role {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:general:configuration-role";
  prefix srl-conf-role;

  import srl_nokia-system {
    prefix srl-sys;
  }
  import srl_nokia-configuration {
    prefix srl-conf;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-aaa {
    prefix srl-aaa;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines configuration and state related to AAA roles.

     Copyright 2021-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2021-03-31 {
    description
      "SR Linux 21.3.1";
  }

  typedef path-action {
    type enumeration {
      enum read {
        description
          "This path may be read by the role";
      }
      enum write {
        description
          "This path may be written and read by the role";
      }
      enum deny {
        description
          "This path may not be read or written to by the role";
      }
    }
  }

  grouping system-roles-top {
    list role {
      description
        "List of roles configured in the system";
      srl-exts:first-released "21.3.1";
      max-elements 32;
      key "name";
      leaf name {
        type leafref {
          path "/srl-sys:system/srl-aaa:aaa/srl-aaa:authorization/srl-aaa:role/srl-aaa:rolename";
        }
      }
      list rule {
        max-elements 256;
        description
          "List of paths to perform access control against";
        key "path-reference";
        leaf path-reference {
          srl-exts:no-globbing;
          type string {
            pattern '[A-Za-z0-9 !@#$%^&()|+=`~.,/_:;?\-{}*\\\\"\[\]]+';
          }
          description
            "Reference to a valid YANG path, in CLI notation

             This path may include keys, wildcards, ranges, and other management server supported constructs. Ranges will be expanded.
             The root path can be specified with '/'.

             E.g.
                 /
                 \"/interface\"
                 \"/acl ipv4-filter foo* description\"";
        }
        leaf action {
          mandatory true;
          type path-action;
          description
            "Action to allow for this path";
        }
      }
      list oc-rule {
        max-elements 256;
        description
          "List of OpenConfig paths to perform access control against

           These rules mirror the 'rule' list but are evaluated as static RBAC by the OpenConfig
           management server against OpenConfig paths. The 'rule' list applies to the native
           management interface (paths in native YANG notation), whereas this 'oc-rule' list applies
           to access performed via the OpenConfig management server (paths in OpenConfig notation).";
        key "path-reference";
        leaf path-reference {
          srl-exts:no-globbing;
          type string {
            pattern '[A-Za-z0-9 !@#$%^&()|+=`~.,/_:;?\-{}*\\\\"\[\]]+';
          }
          description
            "Reference to a valid OpenConfig YANG path, in CLI notation

             This path may include keys, wildcards, ranges, and other management server supported constructs. Ranges will be expanded.
             The root path can be specified with '/'.

             E.g.
                 /
                 \"/interfaces interface mgmt0\"
                 \"/interfaces interface mgmt0 config enabled\"";
        }
        leaf action {
          mandatory true;
          type path-action;
          description
            "Action to allow for this path";
        }
      }
    }
  }

  augment "/srl-sys:system/srl-conf:configuration" {
    uses system-roles-top;
  }
}
