module srl_nokia-tools-event-handler {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:event:tools-event-handler";
  prefix srl-tool-even-hand;

  import srl_nokia-common {
    prefix srl-comm;
  }
  import srl_nokia-tools-system {
    prefix srl-tool-sys;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines operational commands for the event handler

     Copyright 2022-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2022-03-31 {
    description
      "SR Linux 22.3.1";
  }

  grouping eh-tools-top {
    container event-handler {
      presence "Configure tools event-handler";
      description
        "Top-level container for operational commands on event handler and event handling instances";
      list instance {
        max-elements 20;
        description
          "List of all event handler instances";
        key "name";
        leaf name {
          type srl-comm:name;
          description
            "A user-defined name for this event handler instance";
        }
        leaf reload {
          type empty;
          description
            "Reload the Python script for this event handler instance";
        }
        container statistics {
          description
            "Enter the statistics context

             Top-level container for operational commands on event handler statistics";
          leaf clear {
            type empty;
            description
              "Clear statistics for this event handler instance";
          }
        }
      }
    }
  }

  augment "/srl-tool-sys:system" {
    srl-exts:first-released "22.6.1";
    uses eh-tools-top;
  }
}
