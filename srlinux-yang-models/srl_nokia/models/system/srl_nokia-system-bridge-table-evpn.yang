module srl_nokia-system-bridge-table-evpn {
  yang-version 1.1;
  namespace "urn:nokia.com:srlinux:evpn:system-bridge-table-evpn";
  prefix srl-sys-brid-tbl-evpn;

  import srl_nokia-system {
    prefix srl-sys;
  }
  import srl_nokia-extensions {
    prefix srl-exts;
  }
  import srl_nokia-features {
    prefix srl-feat;
  }
  import srl_nokia-system-bridge-table {
    prefix srl-sys-brid-tbl;
  }

  organization
    "Nokia";
  contact
    "Nokia SR Linux Support
     Web: <http://www.nokia.com>";
  description
    "This module defines system bridge-table evpn operational
     state data

     Copyright 2024-2026 Nokia. All rights reserved. Reproduction of this document
     is authorized on the condition that the foregoing copyright notice is included.";

  revision 2026-10-31 {
    description
      "SR Linux 26.10.1";
  }
  revision 2026-07-31 {
    description
      "SR Linux 26.7.1";
  }
  revision 2024-07-31 {
    description
      "SR Linux 24.7.1";
  }

  grouping bridge-table-evpn-top {
    container evpn {
      if-feature "srl-feat:evpn";
      srl-exts:first-released "20.10.1";
      description
        "Enter the evpn context

         System bridge-table BGP-EVPN information";
    }
  }

  augment "/srl-sys:system/srl-sys-brid-tbl:bridge-table" {
    uses bridge-table-evpn-top;
  }
}
